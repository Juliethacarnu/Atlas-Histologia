      "presentation": { "reveal": "always", "panel": "dedicated" }
    },
    {
      "label": "optimizar imágenes",
      "detail": "Convierte ./originales/ a WebP en public/placas/ (o genera placeholders)",
      "type": "shell",
      "command": "npm run optimizar",
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated" }
    },
    {
      "label": "previsualizar build",
      "detail": "Sirve dist/ como lo verá GitHub Pages",
      "type": "shell",
      "command": "npm run preview",
      "isBackground": true,
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated" }
    },
    {
      "label": "comprobar tipos",
      "detail": "astro check: tipos y esquemas de contenido",
