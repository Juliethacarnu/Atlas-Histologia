---
import { getCollection, getEntry } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import Base from '../../layouts/Base.astro';
import VisorPlaca from '../../componentes/VisorPlaca.astro';
import PanelEstructuras from '../../componentes/PanelEstructuras.astro';
import ExplicadorFlotante from '../../componentes/ExplicadorFlotante.astro';
import MiniQuiz from '../../componentes/MiniQuiz.astro';
import AsaFicha from '../../componentes/AsaFicha.astro';
import { SISTEMAS, nombreSistema } from '../../datos/sistemas';
import { imagenesDe, urlImagen, puntosDe, ordenarPlacas } from '../../utils/placas';
import { ruta, rutaPlaca } from '../../utils/ruta';
import type { DatosPlaca } from '../../cliente/tipos';
import type { Placa } from '../../utils/placas';
import Icono from '../../componentes/Icono.astro';

interface Props {
  placa: Placa;
  anterior: Placa | null;
  siguiente: Placa | null;
  posicion: number;
  total: number;
}

export const getStaticPaths: GetStaticPaths = async () => {
  const placas = await getCollection('placas');
  const orden = ordenarPlacas(
    placas,
    SISTEMAS.map((s) => s.id),
  );
  return orden.map((entrada, i) => ({
    params: { id: entrada.data.id },
    props: {
      placa: entrada.data,
      anterior: orden[i - 1]?.data ?? null,
      siguiente: orden[i + 1]?.data ?? null,
      posicion: i + 1,
      total: orden.length,
    },
  }));
};

const { placa, anterior, siguiente, posicion, total } = Astro.props;
const presentadorEntrada = placa.presentador
  ? await getEntry('presentadores', placa.presentador)
  : undefined;
const presentador = presentadorEntrada?.data ?? null;

const imagenes = imagenesDe(placa);

// Datos que consume el cliente: sólo lo necesario, con coordenadas normalizadas.
const datosCliente: DatosPlaca = {
  id: placa.id,
  titulo: placa.titulo,
  imagenes: imagenes.map((im) => ({
    url: urlImagen(im.archivo, 'grande'),
    aumento: im.aumento,
    credito: im.credito || placa.credito,
  })),
  estructuras: placa.estructuras.map((e) => ({
    id: e.id,
    numero: e.numero,
    nombre: e.nombre,
    descripcion: e.descripcion,
    puntos: puntosDe(e),
  })),
  video: placa.video,
};

const descripcion =
  placa.descripcionGeneral ||
  `Preparación de ${placa.organo} teñida con ${placa.tincion}, con ${placa.estructuras.length} estructuras señaladas.`;
---

<Base
  titulo={placa.titulo}
  descripcion={descripcion}
  imagen={urlImagen(imagenes[0]!.archivo, 'media')}
  anchoCompleto
  pagina="placa"
  encabezadoCompacto
  pie={false}
>
  <script
    type="application/json"
    id="datos-placa"
    set:html={JSON.stringify(datosCliente)}
    is:inline
  ></script>
  <!-- Barra de contexto y navegación entre placas -->
  <nav
    id="nav-placas"
    class="contenedor-atlas flex items-center gap-2 py-2 text-[0.82rem] sm:gap-3 sm:text-sm"
    aria-label="Navegación entre placas"
    data-anterior={anterior ? rutaPlaca(anterior.id) : ''}
    data-siguiente={siguiente ? rutaPlaca(siguiente.id) : ''}
  >
    <a href={ruta()} class="shrink-0 text-texto-suave hover:text-texto">
      <Icono nombre="arrow-left" />
      <span class="max-sm:hidden"> Todas las láminas</span>
      <span class="sm:hidden"> Láminas</span>
    </a>
    <span class="text-texto-suave/40" aria-hidden="true">/</span>
    <span class="truncate text-texto-suave">{nombreSistema(placa.sistema)}</span>
    <span class="ml-auto shrink-0 tabular-nums text-texto-suave">
      {posicion} / {total}
    </span>
    <div class="flex shrink-0 gap-1">
      {/* En movil las miniaturas no caben sobre una foto de 280 px y encima
          compiten con el gesto de arrastrar: se abren desde aqui como hoja. */}
      {imagenes.length > 1 && (
        <button
          type="button"
          id="abrir-laminas"
          class="nav-flecha lg:hidden"
          aria-expanded="false"
          aria-controls="tira-imagenes"
        >
          <span class="solo-lectores">
            Ver las {imagenes.length} imágenes de esta lámina
          </span>
          <Icono nombre="images-square" />
        </button>
      )}
      {anterior ? (
        <a
          href={rutaPlaca(anterior.id)}
          rel="prev"
          class="nav-flecha"
          aria-keyshortcuts="ArrowLeft"
          title={`Anterior: ${anterior.titulo}`}
        >
          <span class="solo-lectores">Placa anterior: {anterior.titulo}</span>
          <Icono nombre="caret-left" peso="bold" />
        </a>
      ) : (
        <span class="nav-flecha nav-flecha--inerte" aria-hidden="true">
          <Icono nombre="caret-left" peso="bold" />
        </span>
      )}
      {siguiente ? (
        <a
          href={rutaPlaca(siguiente.id)}
          rel="next"
          class="nav-flecha"
          aria-keyshortcuts="ArrowRight"
          title={`Siguiente: ${siguiente.titulo}`}
        >
          <span class="solo-lectores">Placa siguiente: {siguiente.titulo}</span>
          <Icono nombre="caret-right" peso="bold" />
        </a>
      ) : (
        <span class="nav-flecha nav-flecha--inerte" aria-hidden="true">
          <Icono nombre="caret-right" peso="bold" />
        </span>
      )}
    </div>
  </nav>

  <h1 class="solo-lectores">{placa.titulo}</h1>

  <!-- El visor es el protagonista: el panel y el avatar flotan encima. -->
  <div class="relative lg:h-[calc(100dvh-var(--alto-superior,5.95rem))]">
    <div class="marco-alto w-full">
      <VisorPlaca imagenes={imagenes} titulo={placa.titulo} />
    </div>
    <AsaFicha presentador={presentador} conExplicacion={!!placa.video} />
    <PanelEstructuras placa={placa} />
    <ExplicadorFlotante placa={placa} presentador={presentador} />
  </div>

  <MiniQuiz />

  <!-- Fuente y crédito de la placa, fuera del campo del visor -->
  {(placa.fuente || placa.credito) && (
    <section class="contenedor-atlas py-7 text-sm text-texto-suave">
      <h2 class="rotulo mb-1.5">Fuente de esta lámina</h2>
      <p class="medida">
        {placa.fuente}
        {placa.credito && ` · ${placa.credito}`}
      </p>
    </section>
  )}
</Base>

<style>
  /* --- El alto del visor ---
     En movil manda una medida fija: 280 px a 390 px de ancho, como pide el
     sistema. Con la ficha subida a media altura el visor se encoge a 160 y
     la foto se recoloca para que el marcador elegido siga a la vista. */
  .marco-alto {
    height: var(--medida-visor);
    transition: height 240ms var(--ease-visor);
  }
  :root[data-ficha='media'] .marco-alto,
  :root[data-ficha='alta'] .marco-alto {
    height: var(--medida-visor-con-ficha);
  }
  /* En tableta hay sitio de sobra: la lamina crece con la ventana. */
  @media (min-width: 640px) and (max-width: 1023px) {
    .marco-alto {
      height: 46dvh;
    }
  }
  @media (min-width: 1024px) {
    .marco-alto,
    :root[data-ficha] .marco-alto {
      height: 100%;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .marco-alto {
      transition: none;
    }
  }

  .nav-flecha {
    position: relative;
    display: grid;
    place-items: center;
    height: 1.9rem;
    width: 1.9rem;
    border-radius: var(--radius-chapa);
    border: 1px solid var(--atlas-borde);
    color: var(--atlas-texto-suave);
    transition:
      color 140ms,
      background-color 140ms;
  }
  .nav-flecha .icono {
    font-size: 0.95rem;
  }
  /* El boton se ve de 1,9rem, pero se pulsa en 44 px: en una barra de 48 px
     no caben tres circulos de 44 junto al rastro de migas. */
  .nav-flecha::before {
    content: '';
    position: absolute;
    inset: calc((1.9rem - var(--medida-tactil)) / 2);
  }
  .nav-flecha:hover {
    background: var(--atlas-superficie);
    color: var(--atlas-texto);
  }
  .nav-flecha--inerte {
    opacity: 0.3;
  }
  /* El boton de imagenes es solo de movil. La utilidad lg:hidden va en una
     capa y pierde contra el display de .nav-flecha, que no la tiene. */
  @media (min-width: 1024px) {
    #abrir-laminas {
      display: none;
    }
  }
</style>

<script>
  import '../../cliente/placa';
</script>
