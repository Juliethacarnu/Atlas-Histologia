---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { SISTEMAS, TOTAL_PLACAS_ESPERADAS } from '../datos/sistemas';
import { ordenarPlacas } from '../utils/placas';
import { rutaPlaca } from '../utils/ruta';

const placas = ordenarPlacas(
  await getCollection('placas'),
  SISTEMAS.map((s) => s.id),
);

const conFuente = placas.filter((p) => p.data.fuente || p.data.credito);
const sinFuente = placas.filter((p) => !p.data.fuente && !p.data.credito);

// Casi veinte láminas repiten exactamente la misma fuente. Se agrupan para
// decirla una vez y no veinte.
const porFuente = new Map<string, typeof conFuente>();
for (const p of conFuente) {
  const clave = p.data.fuente?.trim() || '';
  const grupo = porFuente.get(clave);
  if (grupo) grupo.push(p);
  else porFuente.set(clave, [p]);
}
const gruposFuente = [...porFuente.entries()]
  .map(([fuente, suyas]) => ({ fuente, placas: suyas }))
  .sort((a, b) => b.placas.length - a.placas.length);

const recuento = SISTEMAS.map((s) => ({
  ...s,
  reales: placas.filter((p) => p.data.sistema === s.id).length,
}));
const descuadre = recuento.filter((r) => r.reales !== r.placasEsperadas);

// Bibliografía del proyecto. Cita la edición que uses realmente.
const bibliografia = [
  {
    texto: 'Atlas de Histología. Universidad de Zaragoza (s. f.).',
    nota: 'Procedencia que citan las propias láminas tomadas de ese atlas.',
    url: null,
  },
  {
    texto: 'Pawlina W, Ross MH. Histología. Texto y atlas. 8.ª edición. Wolters Kluwer, 2020.',
    nota: null,
    url: null,
  },
  {
    texto: 'Histology Guide (University of Leeds). Virtual histology laboratory.',
    nota: null,
    url: 'https://histology.leeds.ac.uk/',
  },
  {
    texto: 'Fotografías propias de las preparaciones del laboratorio de la asignatura.',
    nota: null,
    url: null,
  },
];
---

<Base
  titulo="Créditos y fuentes"
  descripcion="Créditos de las imágenes de cada placa y bibliografía consultada para las descripciones de las estructuras."
>
  <header class="cabecera-pagina">
    <h1>Créditos y fuentes</h1>
    <p class="cabecera-pagina__entrada">
      Las descripciones de las estructuras se redactaron a partir de las fuentes de abajo. Las
      imágenes son fotografías de las preparaciones del laboratorio salvo donde se indique otra
      procedencia.
    </p>
  </header>

  <section class="mb-14">
    <h2 class="titulo-seccion">Bibliografía</h2>
    <ol class="medida flex list-decimal flex-col gap-3 pl-5">
      {bibliografia.map((b) => (
        <li>
          {b.url ? (
            <a
              href={b.url}
              class="underline decoration-borde underline-offset-4 hover:decoration-eosina"
              rel="noopener"
            >
              {b.texto}
            </a>
          ) : (
            b.texto
          )}
          {b.nota && <span class="block text-sm text-texto-suave">{b.nota}</span>}
        </li>
      ))}
    </ol>
  </section>

  <section class="mb-14">
    <h2 class="titulo-seccion">Créditos de las imágenes</h2>
    {conFuente.length === 0 ? (
      <p class="medida text-texto-suave">
        Ninguna lámina declara todavía los campos <code>fuente</code> o <code>credito</code>.
        Rellénalos en el JSON de cada lámina y aparecerán aquí automáticamente.
      </p>
    ) : (
      <div class="flex flex-col gap-9">
        {gruposFuente.map((g) => (
          <div>
            <h3 class="grupo-fuente">
              <span class="grupo-fuente__texto">
                {g.fuente || 'Sin fuente declarada'}
              </span>
              <span class="grupo-fuente__regla" aria-hidden="true"></span>
              <span class="grupo-fuente__cuenta tabular-nums">{g.placas.length}</span>
            </h3>
            <ul class="lista-creditos">
              {g.placas.map((p) => (
                <li>
                  <a href={rutaPlaca(p.data.id)} class="lista-creditos__placa">
                    {p.data.titulo}
                    {p.data.aumentos.length > 0 && (
                      <span class="tabular-nums">{p.data.aumentos.join(' · ')}</span>
                    )}
                  </a>
                  {p.data.credito && <span class="lista-creditos__pie">{p.data.credito}</span>}
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    )}
    {sinFuente.length > 0 && (
      <p class="medida mt-4 text-sm text-texto-suave">
        {sinFuente.length} de {placas.length} láminas aún no declaran fuente ni crédito.
      </p>
    )}
  </section>

  <section>
    <h2 class="titulo-seccion">Estado del atlas</h2>
    <p class="medida mb-4 text-sm text-texto-suave">
      {placas.length} de {TOTAL_PLACAS_ESPERADAS} láminas cargadas.
    </p>
    <ul class="flex list-none flex-col gap-1.5 p-0 text-sm">
      {recuento.map((r) => (
        <li class="flex items-baseline gap-2">
          <span
            class="h-1.5 w-1.5 shrink-0 rounded-full"
            style={`background:${r.acento}`}
            aria-hidden="true"
          />
          <span>{r.nombre}</span>
          <span class="ml-auto tabular-nums text-texto-suave">
            {r.reales} / {r.placasEsperadas}
          </span>
        </li>
      ))}
    </ul>
    {descuadre.length > 0 && (
      <p class="medida mt-4 rounded-lg border border-eosina/40 bg-eosina-tenue p-3 text-sm text-nucleo">
        Hay sistemas con un número de láminas distinto al previsto:{' '}
        {descuadre.map((d) => d.nombre).join(', ')}. Revisa los archivos de
        <code class="mx-1">src/content/placas/</code>.
      </p>
    )}
  </section>
</Base>

<style>
  .cabecera-pagina {
    padding-block: clamp(1.75rem, 1rem + 3vw, 3.25rem) clamp(1.75rem, 1rem + 2.5vw, 2.75rem);
    border-bottom: 1px solid var(--atlas-borde);
    margin-bottom: clamp(2rem, 1rem + 2.5vw, 3rem);
  }
  .cabecera-pagina h1 {
    font-size: clamp(2.2rem, 1.3rem + 3.4vw, 3.4rem);
    font-weight: 400;
    letter-spacing: -0.028em;
  }
  .cabecera-pagina__entrada {
    max-width: 56ch;
    margin-top: 1rem;
    font-size: 1.02rem;
    line-height: 1.65;
    color: var(--atlas-texto-suave);
  }

  .titulo-seccion {
    margin-bottom: 1.1rem;
    font-size: 1.45rem;
    font-weight: 450;
    letter-spacing: -0.015em;
  }

  /* Cada fuente se nombra una vez y debajo van sus láminas. */
  .grupo-fuente {
    display: grid;
    grid-template-columns: minmax(0, max-content) 1fr auto;
    align-items: center;
    gap: 0.9rem;
    margin-bottom: 0.9rem;
    font-family: var(--font-sans);
    font-size: 0.82rem;
    font-weight: 500;
    line-height: 1.4;
  }
  .grupo-fuente__texto {
    min-width: 0;
  }
  .grupo-fuente__regla {
    height: 1px;
    background: var(--atlas-borde);
  }
  .grupo-fuente__cuenta {
    font-weight: 400;
    color: var(--atlas-texto-suave);
  }

  .lista-creditos {
    display: grid;
    gap: 0.55rem 2rem;
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: 0.85rem;
  }
  @media (min-width: 720px) {
    .lista-creditos {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  .lista-creditos li {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.1rem 0.6rem;
    border-bottom: 1px solid var(--atlas-borde);
    padding-bottom: 0.5rem;
  }
  .lista-creditos__placa {
    display: inline-flex;
    align-items: baseline;
    gap: 0.4rem;
    text-decoration: none;
    transition: color 150ms;
  }
  .lista-creditos__placa:hover {
    color: var(--color-eosina);
  }
  .lista-creditos__placa span {
    font-size: 0.72rem;
    color: var(--atlas-texto-suave);
  }
  .lista-creditos__pie {
    flex: 1;
    min-width: 0;
    font-size: 0.76rem;
    color: var(--atlas-texto-suave);
  }
  @media (min-width: 720px) {
    .lista-creditos__pie {
      text-align: right;
    }
  }

  code {
    border-radius: 4px;
    background: var(--atlas-superficie-alta);
    border: 1px solid var(--atlas-borde);
    padding: 0.05rem 0.3rem;
    font-size: 0.85em;
  }
</style>
