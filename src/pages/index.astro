---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Portaobjetos from '../componentes/Portaobjetos.astro';
import BuscadorFiltros from '../componentes/BuscadorFiltros.astro';
import { SISTEMAS, TOTAL_PLACAS_ESPERADAS } from '../datos/sistemas';
import { imagenesDe, urlImagen } from '../utils/placas';

const placas = await getCollection('placas');
const conteos: Record<string, number> = {};
for (const s of SISTEMAS) {
  conteos[s.id] = placas.filter((p) => p.data.sistema === s.id).length;
}

const porSistema = SISTEMAS.map((s) => ({
  sistema: s,
  placas: placas
    .filter((p) => p.data.sistema === s.id)
    .sort((a, b) => a.data.titulo.localeCompare(b.data.titulo, 'es')),
}));

// Dos placas del mismo sistema pueden llamarse igual y distinguirse solo por
// el aumento (Bazo ×10 y Bazo ×100). En ese caso el titulo lo lleva dentro.
const repetidos = new Set<string>();
for (const { placas: delSistema } of porSistema) {
  const vistos = new Set<string>();
  for (const p of delSistema) {
    if (vistos.has(p.data.titulo)) repetidos.add(p.data.titulo);
    vistos.add(p.data.titulo);
  }
}

// Cada entrada del indice lleva dentro un trocito de una de sus laminas: se
// reconoce el sistema por el tejido antes que por el nombre.
const muestras: Record<string, string> = {};
for (const { sistema, placas: delSistema } of porSistema) {
  const primera = delSistema[0];
  if (primera) muestras[sistema.id] = urlImagen(imagenesDe(primera.data)[0]!.archivo, 'miniatura');
}

// La cinta de la portada: dos laminas de cada sistema, en el mismo orden del
// atlas. Son las mismas miniaturas que usa la bandeja, asi que el navegador
// las sirve de su cache y no cuestan una descarga mas.
const cinta = porSistema.flatMap(({ placas: delSistema }) =>
  delSistema.slice(0, 2).map((p) => urlImagen(imagenesDe(p.data)[0]!.archivo, 'miniatura')),
);

const totalEstructuras = placas.reduce((n, p) => n + p.data.estructuras.length, 0);
const cifras = [
  { n: placas.length, etiqueta: placas.length === 1 ? 'lámina' : 'láminas' },
  { n: totalEstructuras, etiqueta: 'estructuras señaladas' },
  { n: SISTEMAS.length, etiqueta: 'sistemas' },
];
let contadorGlobal = 0;
---

<Base titulo="Atlas virtual de histologia" anchoCompleto>
  {/* ---------- La consola: la portada es el panel de mando ---------- */}
  <section class="consola" id="consola">
    <div class="consola__foco" aria-hidden="true"></div>

    <div class="consola__cuerpo contenedor-bandeja">
      <p class="consola__kicker rotulo">Atlas digital · hematoxilina y eosina</p>

      <h1 class="consola__titulo">
        Atlas virtual<br /><span class="consola__titulo-luz">de histología</span>
      </h1>

      <p class="consola__entrada">
        {TOTAL_PLACAS_ESPERADAS} preparaciones teñidas con hematoxilina y eosina. Cada lámina se abre
        en un visor con zoom profundo y sus estructuras están señaladas una a una.
      </p>

      <div class="consola__acciones">
        <a class="boton-luz" href="#titulo-bandeja">
          Explorar las láminas
          <span class="boton-luz__flecha" aria-hidden="true">↓</span>
        </a>
        <span class="consola__atajo rotulo">o busca una estructura por su nombre</span>
      </div>

      {/* Las tres lecturas del aparato. */}
      <dl class="lecturas">
        {cifras.map((c) => (
          <div class="lecturas__celda">
            <dt class="lecturas__cifra tabular-nums">{c.n}</dt>
            <dd class="lecturas__etiqueta">{c.etiqueta}</dd>
          </div>
        ))}
        <div class="lecturas__celda lecturas__celda--canales">
          <dt class="lecturas__canales" aria-hidden="true">
            {SISTEMAS.map((s) => (
              <span
                class="lecturas__canal"
                style={`--acento-sistema:${s.acento}; --senal:${(conteos[s.id] ?? 0) / 15}`}
              />
            ))}
          </dt>
          <dd class="lecturas__etiqueta">láminas por sistema</dd>
        </div>
      </dl>
    </div>

    {/* La cinta: doce preparaciones pasando de largo. Es decoracion, no un
        indice: el indice de verdad esta justo debajo y es navegable. */}
    <div class="cinta" aria-hidden="true">
      <div class="cinta__pista">
        {[...cinta, ...cinta].map((src) => (
          <img class="cinta__lamina" src={src} alt="" loading="lazy" decoding="async" />
        ))}
      </div>
    </div>
  </section>

  <section class="bandeja contenedor-bandeja" aria-labelledby="titulo-bandeja">
    <h2 id="titulo-bandeja" class="solo-lectores">Todas las láminas</h2>

    {/* El componente escupe dos piezas: el campo de busqueda y el indice de
        sistemas. La rejilla de aqui las coloca. */}
    <BuscadorFiltros conteos={conteos} total={placas.length} muestras={muestras} />

    <div class="bandeja__laminas">
      {porSistema.map(({ sistema, placas: delSistema }, i) => (
        <section data-grupo-sistema={sistema.id} aria-labelledby={`sis-${sistema.id}`}>
          <header class="grupo" style={`--acento-sistema: ${sistema.acento}`}>
            <span class="grupo__orden tabular-nums" aria-hidden="true">
              {String(i + 1).padStart(2, '0')}
            </span>
            <h3 id={`sis-${sistema.id}`} class="grupo__titulo">
              {sistema.nombre}
            </h3>
            <span class="grupo__cuenta tabular-nums">
              {delSistema.length}
              <span class="grupo__cuenta-palabra">
                {delSistema.length === 1 ? ' lámina' : ' láminas'}
              </span>
            </span>
            <p class="grupo__descripcion rotulo">{sistema.descripcion}</p>
          </header>

          <ul class="rejilla">
            {delSistema.map((p) => {
              contadorGlobal++;
              return (
                <Portaobjetos
                  placa={p.data}
                  prioridad={contadorGlobal <= 8}
                  tituloRepetido={repetidos.has(p.data.titulo)}
                />
              );
            })}
          </ul>
        </section>
      ))}

      <div id="sin-resultados" hidden class="vacio">
        <p class="vacio__titulo">
          Ninguna lámina dice «<span id="vacio-termino"></span>»
        </p>
        <p class="vacio__pista">
          La búsqueda ignora tildes y mayúsculas, y mira también el órgano, el sistema y el
          nombre de cada estructura.
        </p>
        <div id="vacio-cerca" hidden>
          <p class="rotulo">Quizá buscabas</p>
          <ul id="vacio-lista" class="vacio__lista" role="list"></ul>
        </div>
        <button type="button" id="vacio-limpiar" class="vacio__boton">
          Ver las {placas.length} láminas
        </button>
      </div>
    </div>
  </section>
</Base>

<style>
  /* ============================================================
     LA CONSOLA
     ============================================================ */
  .consola {
    position: relative;
    overflow: hidden;
    padding-block: clamp(2.5rem, 1rem + 5vw, 5rem) 0;
  }

  /* El foco que sigue al puntero: la lampara del microscopio moviendose por
     encima del panel. Sin raton se queda donde estaba y no molesta. */
  .consola__foco {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background: radial-gradient(
      22rem 22rem at var(--mx, 50%) var(--my, 30%),
      color-mix(in srgb, var(--atlas-acento) 20%, transparent),
      transparent 70%
    );
    opacity: 0;
    transition: opacity 500ms var(--suave);
  }
  .consola[data-foco='si'] .consola__foco {
    opacity: 1;
  }

  .consola__cuerpo {
    position: relative;
    z-index: 1;
  }

  .consola__kicker {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    border: 1px solid var(--filo-vidrio);
    border-radius: 999px;
    background: var(--vidrio);
    backdrop-filter: blur(10px);
    padding: 0.3rem 0.8rem;
    color: var(--atlas-texto);
  }
  .consola__kicker::before {
    content: '';
    height: 0.4rem;
    width: 0.4rem;
    border-radius: 999px;
    background: var(--color-sis-digestivo);
    box-shadow: 0 0 9px 0 var(--color-sis-digestivo);
  }

  .consola__titulo {
    margin-top: 1.1rem;
    font-size: clamp(2.7rem, 0.6rem + 8vw, 6.4rem);
    font-weight: 600;
    line-height: 0.94;
    letter-spacing: -0.052em;
  }

  /* La segunda linea se pinta con el degradado del atlas y se mueve despacio:
     es lo unico animado del titulo. */
  .consola__titulo-luz {
    background: linear-gradient(
      96deg,
      var(--color-sis-urinario),
      var(--color-eosina) 34%,
      var(--atlas-acento) 68%,
      var(--color-sis-urinario)
    );
    background-size: 280% 100%;
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    animation: luz-corre 14s linear infinite;
  }
  @keyframes luz-corre {
    to {
      background-position: 280% 0;
    }
  }

  .consola__entrada {
    max-width: 44ch;
    margin-top: 1.4rem;
    font-size: clamp(1rem, 0.94rem + 0.3vw, 1.12rem);
    line-height: 1.6;
    color: var(--atlas-texto-suave);
  }

  .consola__acciones {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.3rem;
    margin-top: 1.8rem;
  }

  .boton-luz {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    min-height: var(--medida-tactil);
    border-radius: 999px;
    background: var(--atlas-acento);
    padding: 0.6rem 1.35rem;
    font-family: var(--font-serif);
    font-size: 0.98rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--sobre-acento);
    text-decoration: none;
    box-shadow: 0 0 30px -8px color-mix(in srgb, var(--atlas-acento) 85%, transparent);
    transition:
      transform 200ms var(--brinco),
      filter 200ms;
  }
  .boton-luz:hover {
    transform: translateY(-2px);
    filter: brightness(1.14);
  }
  .boton-luz__flecha {
    transition: transform 240ms var(--brinco);
  }
  .boton-luz:hover .boton-luz__flecha {
    transform: translateY(3px);
  }

  /* ---------- Las lecturas del aparato ---------- */
  .lecturas {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(7.5rem, 1fr));
    gap: 1px;
    margin: clamp(2rem, 1rem + 2.5vw, 3rem) 0 0;
    border: 1px solid var(--filo-vidrio);
    border-radius: var(--radius-ficha);
    background: var(--filo-vidrio);
    overflow: hidden;
  }
  .lecturas__celda {
    background: var(--vidrio);
    backdrop-filter: blur(12px);
    padding: 0.9rem 1.1rem 1rem;
  }
  .lecturas__cifra {
    font-family: var(--font-serif);
    font-size: clamp(1.9rem, 1.2rem + 1.6vw, 2.6rem);
    font-weight: 600;
    line-height: 1;
    letter-spacing: -0.045em;
  }
  .lecturas__etiqueta {
    margin: 0.45rem 0 0;
    font-family: var(--font-instrumento);
    font-size: 0.64rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    line-height: 1.35;
    color: var(--atlas-texto-suave);
  }

  /* Seis barras, una por sistema, con el alto proporcional a sus laminas. */
  .lecturas__canales {
    display: flex;
    align-items: flex-end;
    gap: 0.45rem;
    height: clamp(1.9rem, 1.2rem + 1.6vw, 2.6rem);
  }
  .lecturas__canal {
    width: 0.4rem;
    flex: none;
    height: calc(26% + 74% * var(--senal, 0.3));
    border-radius: 999px;
    background: var(--acento-sistema);
    box-shadow: 0 0 10px -2px var(--acento-sistema);
  }

  /* ---------- La cinta de preparaciones ---------- */
  .cinta {
    position: relative;
    z-index: 1;
    margin-top: clamp(2rem, 1rem + 2.5vw, 3.25rem);
    padding-block: 0.9rem;
    border-top: 1px solid var(--filo-vidrio);
    border-bottom: 1px solid var(--filo-vidrio);
    overflow: hidden;
    -webkit-mask-image: linear-gradient(to right, transparent, #000 7rem, #000 calc(100% - 7rem), transparent);
    mask-image: linear-gradient(to right, transparent, #000 7rem, #000 calc(100% - 7rem), transparent);
  }
  .cinta__pista {
    display: flex;
    gap: 0.8rem;
    width: max-content;
    animation: cinta-pasa 64s linear infinite;
  }
  .cinta:hover .cinta__pista {
    animation-play-state: paused;
  }
  @keyframes cinta-pasa {
    to {
      /* La pista lleva la lista dos veces: al recorrer la mitad, el dibujo
         vuelve a ser el mismo y el salto no se ve. */
      transform: translateX(-50%);
    }
  }
  .cinta__lamina {
    height: clamp(3.6rem, 2.4rem + 3vw, 5.4rem);
    width: clamp(5.4rem, 3.4rem + 5vw, 8.4rem);
    flex: none;
    border-radius: 0.6rem;
    object-fit: cover;
    box-shadow: 0 0 0 1px var(--filo-vidrio);
    filter: saturate(1.05);
  }
  @media (prefers-reduced-motion: reduce) {
    .cinta__pista {
      animation: none;
    }
    .consola__titulo-luz {
      animation: none;
    }
  }

  /* ============================================================
     LA BANDEJA
     ============================================================ */
  .bandeja {
    display: grid;
    gap: 1.5rem;
    padding-top: clamp(2.25rem, 1rem + 3vw, 3.5rem);
    padding-bottom: 2.5rem;
  }
  @media (min-width: 1100px) {
    .bandeja {
      /* El indice vive en su propia columna y se queda pegado al desplazar;
         asi los seis sistemas estan siempre a un clic sin volver arriba. */
      grid-template-columns: 13rem minmax(0, 1fr);
      grid-template-areas:
        'indice buscar'
        'indice laminas';
      column-gap: 3rem;
      row-gap: 2rem;
      align-items: start;
    }
    .bandeja > :global(.buscador) {
      grid-area: buscar;
    }
    .bandeja > :global(.indice) {
      grid-area: indice;
    }
    .bandeja__laminas {
      grid-area: laminas;
    }
  }

  .bandeja__laminas {
    display: flex;
    flex-direction: column;
    gap: 3.5rem;
  }

  /* ---------- Cada sistema es un canal numerado ---------- */
  .grupo {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    column-gap: 0.85rem;
    row-gap: 0.35rem;
    margin-bottom: 1.25rem;
    padding-bottom: 0.7rem;
    border-bottom: 1px solid var(--filo-vidrio);
  }

  .grupo__orden {
    display: grid;
    place-items: center;
    height: 2rem;
    width: 2rem;
    border-radius: 0.6rem;
    background: color-mix(in srgb, var(--acento-sistema) 18%, transparent);
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--acento-sistema) 45%, transparent);
    font-family: var(--font-instrumento);
    font-size: 0.74rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: var(--atlas-texto);
  }

  .grupo__titulo {
    font-size: clamp(1.3rem, 1.1rem + 0.7vw, 1.8rem);
    font-weight: 600;
    letter-spacing: -0.038em;
  }

  .grupo__cuenta {
    font-size: 0.7rem;
    color: var(--atlas-texto-suave);
    white-space: nowrap;
  }
  @media (max-width: 479px) {
    .grupo__cuenta-palabra {
      display: none;
    }
  }

  .grupo__descripcion {
    grid-column: 2 / -1;
    margin: 0;
  }
  @media (max-width: 639px) {
    .grupo__descripcion {
      display: none;
    }
  }

  /* ---------- Nada coincide ---------- */
  .vacio {
    max-width: 48ch;
    padding-block: clamp(2rem, 1rem + 3vw, 3rem);
  }
  .vacio__titulo {
    font-size: 1.55rem;
    line-height: 1.25;
  }
  .vacio__pista {
    margin-top: 0.6rem;
    font-size: 0.92rem;
    line-height: 1.6;
    color: var(--atlas-texto-suave);
  }
  #vacio-cerca {
    margin-top: 1.6rem;
    padding-top: 0.8rem;
    border-top: 1px solid var(--filo-vidrio);
  }
  .vacio__lista {
    list-style: none;
    margin: 0.5rem 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
  }
  /* Las sugerencias las construye el cliente: el ámbito de Astro no llega a
     elementos que no están en este archivo, así que van en global. */
  .vacio__lista :global(a) {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    min-height: 44px;
    padding: 0.35rem 0;
    text-decoration: none;
  }
  .vacio__lista :global(a:hover .vacio__nombre) {
    color: var(--color-eosina);
  }
  .vacio__lista :global(.vacio__nombre) {
    font-size: 1.05rem;
  }
  .vacio__lista :global(.vacio__donde) {
    font-size: 0.78rem;
    color: var(--atlas-texto-suave);
  }
  .vacio__boton {
    margin-top: 1.6rem;
    min-height: 44px;
    padding: 0.5rem 1rem;
    font-size: 0.88rem;
  }

  /* ============================================================
     MOSAICO  ·  columnas CSS para que cada lamina guarde su forma
     ============================================================ */
  .rejilla {
    columns: 2;
    column-gap: 1.1rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .rejilla > :global(li) {
    margin-bottom: 1.6rem;
  }
  @media (min-width: 640px) {
    .rejilla {
      columns: 3;
      column-gap: 1.35rem;
    }
  }
  @media (min-width: 1100px) {
    .rejilla {
      columns: 3;
      column-gap: 1.7rem;
    }
    .rejilla > :global(li) {
      margin-bottom: 2.1rem;
    }
  }
</style>

<script>
  /* El foco de la consola sigue al puntero. Solo con raton: en una pantalla
     tactil no hay puntero que seguir y la pagina queda igual. */
  const consola = document.getElementById('consola');
  if (consola && window.matchMedia('(hover: hover)').matches) {
    let pendiente = false;
    let ultimo: PointerEvent | null = null;

    consola.addEventListener('pointermove', (e) => {
      ultimo = e;
      if (pendiente) return;
      pendiente = true;
      requestAnimationFrame(() => {
        pendiente = false;
        if (!ultimo) return;
        const caja = consola.getBoundingClientRect();
        consola.style.setProperty('--mx', `${((ultimo.clientX - caja.left) / caja.width) * 100}%`);
        consola.style.setProperty('--my', `${((ultimo.clientY - caja.top) / caja.height) * 100}%`);
      });
    });
    consola.addEventListener('pointerenter', () => {
      consola.dataset.foco = 'si';
    });
    consola.addEventListener('pointerleave', () => {
      delete consola.dataset.foco;
    });
  }
</script>
