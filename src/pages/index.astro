---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Portaobjetos from '../componentes/Portaobjetos.astro';
import BuscadorFiltros from '../componentes/BuscadorFiltros.astro';
import { SISTEMAS, TOTAL_PLACAS_ESPERADAS } from '../datos/sistemas';
import { imagenesDe, urlImagen } from '../utils/placas';

const placas = await getCollection('placas');
const conteos: Record<string, number> = {};
for (const s of SISTEMAS) {
  conteos[s.id] = placas.filter((p) => p.data.sistema === s.id).length;
}

const porSistema = SISTEMAS.map((s) => ({
  sistema: s,
  placas: placas
    .filter((p) => p.data.sistema === s.id)
    .sort((a, b) => a.data.titulo.localeCompare(b.data.titulo, 'es')),
}));

// Dos placas del mismo sistema pueden llamarse igual y distinguirse solo por
// el aumento (Bazo ×10 y Bazo ×100). En ese caso el titulo lo lleva dentro.
const repetidos = new Set<string>();
for (const { placas: delSistema } of porSistema) {
  const vistos = new Set<string>();
  for (const p of delSistema) {
    if (vistos.has(p.data.titulo)) repetidos.add(p.data.titulo);
    vistos.add(p.data.titulo);
  }
}

// Cada entrada del indice lleva dentro un trocito de una de sus laminas: se
// reconoce el sistema por el tejido antes que por el nombre.
const muestras: Record<string, string> = {};
for (const { sistema, placas: delSistema } of porSistema) {
  const primera = delSistema[0];
  if (primera) muestras[sistema.id] = urlImagen(imagenesDe(primera.data)[0]!.archivo, 'miniatura');
}

const totalEstructuras = placas.reduce((n, p) => n + p.data.estructuras.length, 0);
const cifras = [
  { n: placas.length, etiqueta: placas.length === 1 ? 'lámina' : 'láminas' },
  { n: totalEstructuras, etiqueta: 'estructuras señaladas' },
  { n: SISTEMAS.length, etiqueta: 'sistemas' },
];
let contadorGlobal = 0;
---

<Base titulo="Atlas virtual de histologia" anchoCompleto>
  <!-- Portada: un pliego de apertura con filetes arriba y abajo. -->
  <section class="portada contenedor-bandeja">
    <h1 class="portada__titulo">
      Atlas virtual<br />de histología
    </h1>
    <div class="portada__pie">
      <p class="portada__entrada">
        {TOTAL_PLACAS_ESPERADAS} preparaciones teñidas con hematoxilina y eosina. Cada lámina se abre
        en un visor con zoom profundo y sus estructuras están señaladas una a una.
      </p>
      <dl class="portada__cifras">
        {cifras.map((c) => (
          <div>
            <dt class="tabular-nums">{c.n}</dt>
            <dd>{c.etiqueta}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <section class="bandeja contenedor-bandeja" aria-labelledby="titulo-bandeja">
    <h2 id="titulo-bandeja" class="solo-lectores">Todas las láminas</h2>

    {/* El componente escupe dos piezas: el campo de busqueda y el indice de
        sistemas. La rejilla de aqui las coloca. */}
    <BuscadorFiltros conteos={conteos} total={placas.length} muestras={muestras} />

    <div class="bandeja__laminas">
      {porSistema.map(({ sistema, placas: delSistema }) => (
        <section data-grupo-sistema={sistema.id} aria-labelledby={`sis-${sistema.id}`}>
          <header class="grupo">
            <h3 id={`sis-${sistema.id}`} class="grupo__titulo">
              <span class="grupo__punto" style={`background:${sistema.acento}`} aria-hidden="true" />
              {sistema.nombre}
            </h3>
            <span class="grupo__cuenta tabular-nums">
              {delSistema.length}
              <span class="grupo__cuenta-palabra">
                {delSistema.length === 1 ? ' lámina' : ' láminas'}
              </span>
            </span>
            <p class="grupo__descripcion rotulo">{sistema.descripcion}</p>
          </header>

          <ul class="rejilla">
            {delSistema.map((p) => {
              contadorGlobal++;
              return (
                <Portaobjetos
                  placa={p.data}
                  prioridad={contadorGlobal <= 8}
                  tituloRepetido={repetidos.has(p.data.titulo)}
                />
              );
            })}
          </ul>
        </section>
      ))}

      <div id="sin-resultados" hidden class="vacio">
        <p class="vacio__titulo">
          Ninguna lámina dice «<span id="vacio-termino"></span>»
        </p>
        <p class="vacio__pista">
          La búsqueda ignora tildes y mayúsculas, y mira también el órgano, el sistema y el
          nombre de cada estructura.
        </p>
        <div id="vacio-cerca" hidden>
          <p class="rotulo">Quizá buscabas</p>
          <ul id="vacio-lista" class="vacio__lista" role="list"></ul>
        </div>
        <button type="button" id="vacio-limpiar" class="vacio__boton">
          Ver las {placas.length} láminas
        </button>
      </div>
    </div>
  </section>
</Base>

<style>
  /* --- Portada --- */
  .portada {
    padding-block: clamp(2rem, 1rem + 4vw, 4.25rem) clamp(1.5rem, 1rem + 2vw, 2.25rem);
  }

  .portada__titulo {
    font-size: clamp(2.6rem, 1rem + 6.4vw, 5.6rem);
    font-weight: 400;
    line-height: 0.98;
    letter-spacing: -0.035em;
  }

  /* Debajo del titulo, un filete y a los lados la entradilla y las cifras:
     la apertura de un pliego, no una caja de texto. */
  .portada__pie {
    display: grid;
    gap: 1.5rem;
    margin-top: clamp(1.5rem, 1rem + 1.6vw, 2.25rem);
    padding-top: 1.1rem;
    border-top: 1px solid var(--atlas-texto);
  }
  @media (min-width: 900px) {
    .portada__pie {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: start;
      gap: 3.5rem;
    }
  }

  .portada__entrada {
    max-width: 46ch;
    font-size: clamp(0.98rem, 0.92rem + 0.3vw, 1.08rem);
    line-height: 1.6;
    color: var(--atlas-texto-suave);
  }

  .portada__cifras {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 2.5rem;
    margin: 0;
  }
  .portada__cifras dt {
    font-family: var(--font-serif);
    font-size: 2.1rem;
    font-weight: 400;
    line-height: 1;
    letter-spacing: -0.025em;
  }
  .portada__cifras dd {
    margin: 0.25rem 0 0;
    font-size: 0.74rem;
    line-height: 1.3;
    color: var(--atlas-texto-suave);
  }

  /* --- La bandeja: indice a la izquierda, laminas a la derecha --- */
  .bandeja {
    display: grid;
    gap: 1.5rem;
    padding-bottom: 2rem;
  }
  @media (min-width: 1100px) {
    .bandeja {
      /* El indice vive en su propia columna y se queda pegado al desplazar;
         asi los seis sistemas estan siempre a un clic sin volver arriba. */
      grid-template-columns: 12rem minmax(0, 1fr);
      grid-template-areas:
        'indice buscar'
        'indice laminas';
      column-gap: 3rem;
      row-gap: 2rem;
      align-items: start;
    }
    .bandeja > :global(.buscador) {
      grid-area: buscar;
    }
    .bandeja > :global(.indice) {
      grid-area: indice;
    }
    .bandeja__laminas {
      grid-area: laminas;
    }
  }

  .bandeja__laminas {
    display: flex;
    flex-direction: column;
    gap: 3.5rem;
  }

  /* --- Cabecera de cada sistema --- */
  .grupo {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: baseline;
    column-gap: 0.9rem;
    row-gap: 0.3rem;
    margin-bottom: 1.1rem;
    padding-bottom: 0.6rem;
    border-bottom: 1px solid var(--atlas-texto);
  }

  .grupo__titulo {
    display: flex;
    align-items: baseline;
    gap: 0.55rem;
    font-size: clamp(1.3rem, 1.1rem + 0.7vw, 1.75rem);
    font-weight: 400;
    letter-spacing: -0.02em;
  }

  .grupo__punto {
    height: 0.45rem;
    width: 0.45rem;
    flex: none;
    border-radius: 999px;
    translate: 0 -0.25rem;
  }

  .grupo__cuenta {
    font-size: 0.78rem;
    color: var(--atlas-texto-suave);
    white-space: nowrap;
  }
  @media (max-width: 479px) {
    .grupo__cuenta-palabra {
      display: none;
    }
  }

  .grupo__descripcion {
    grid-column: 1 / -1;
    margin: 0;
  }
  @media (max-width: 639px) {
    .grupo__descripcion {
      display: none;
    }
  }

  /* --- Nada coincide: se dice el termino, como busca el atlas y por donde
     seguir. Nunca se deja al lector en un callejon sin salida. --- */
  .vacio {
    max-width: 48ch;
    padding-block: clamp(2rem, 1rem + 3vw, 3rem);
  }
  .vacio__titulo {
    font-family: var(--font-serif);
    font-size: 1.5rem;
    line-height: 1.25;
  }
  .vacio__titulo span {
    font-style: italic;
  }
  .vacio__pista {
    margin-top: 0.6rem;
    font-size: 0.92rem;
    line-height: 1.6;
    color: var(--atlas-texto-suave);
  }
  #vacio-cerca {
    margin-top: 1.6rem;
    padding-top: 0.8rem;
    border-top: 1px solid var(--atlas-borde);
  }
  .vacio__lista {
    list-style: none;
    margin: 0.5rem 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
  }
  /* Las sugerencias las construye el cliente: el ámbito de Astro no llega a
     elementos que no están en este archivo, así que van en global. */
  .vacio__lista :global(a) {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    min-height: 44px;
    padding: 0.35rem 0;
    text-decoration: none;
  }
  .vacio__lista :global(a:hover .vacio__nombre) {
    color: var(--color-eosina);
  }
  .vacio__lista :global(.vacio__nombre) {
    font-family: var(--font-serif);
    font-size: 1.05rem;
  }
  .vacio__lista :global(.vacio__donde) {
    font-size: 0.78rem;
    color: var(--atlas-texto-suave);
  }
  .vacio__boton {
    margin-top: 1.6rem;
    border: 1px solid var(--atlas-borde-fuerte);
    border-radius: var(--radius-chapa);
    padding: 0.5rem 1rem;
    font-size: 0.88rem;
    min-height: 44px;
    transition:
      border-color 140ms,
      background-color 140ms;
  }
  .vacio__boton:hover {
    border-color: var(--atlas-texto);
    background: var(--atlas-superficie);
  }

  /* --- Mosaico: la bandeja de preparaciones ---
     Columnas CSS en vez de rejilla. Asi cada lamina conserva su forma (la
     traquea es panoramica, el duodeno redondo) y el mosaico se cierra solo,
     sin recortar ninguna ni dejar huecos. --- */
  .rejilla {
    columns: 2;
    column-gap: 1.1rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .rejilla > :global(li) {
    margin-bottom: 1.6rem;
  }
  @media (min-width: 640px) {
    .rejilla {
      columns: 3;
      column-gap: 1.35rem;
    }
  }
  /* Tres columnas y no cuatro: con cuatro, el reparto secuencial de las
     columnas CSS dejaba huecos de media pantalla, y además la lámina se ve
     más grande, que es de lo que se trata. */
  @media (min-width: 1100px) {
    .rejilla {
      columns: 3;
      column-gap: 1.6rem;
    }
    .rejilla > :global(li) {
      margin-bottom: 2.1rem;
    }
  }
</style>
