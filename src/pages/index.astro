---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Portaobjetos from '../componentes/Portaobjetos.astro';
import BuscadorFiltros from '../componentes/BuscadorFiltros.astro';
import { SISTEMAS, TOTAL_PLACAS_ESPERADAS } from '../datos/sistemas';
import { imagenesDe, urlImagen } from '../utils/placas';

const placas = await getCollection('placas');
const conteos: Record<string, number> = {};
for (const s of SISTEMAS) {
  conteos[s.id] = placas.filter((p) => p.data.sistema === s.id).length;
}

const porSistema = SISTEMAS.map((s) => ({
  sistema: s,
  placas: placas
    .filter((p) => p.data.sistema === s.id)
    .sort((a, b) => a.data.titulo.localeCompare(b.data.titulo, 'es')),
}));

// Dos placas del mismo sistema pueden llamarse igual y distinguirse solo por
// el aumento (Bazo ×10 y Bazo ×100). En ese caso el titulo lo lleva dentro.
const repetidos = new Set<string>();
for (const { placas: delSistema } of porSistema) {
  const vistos = new Set<string>();
  for (const p of delSistema) {
    if (vistos.has(p.data.titulo)) repetidos.add(p.data.titulo);
    vistos.add(p.data.titulo);
  }
}

// Cada filtro lleva dentro un trocito de una de sus laminas: se reconoce el
// sistema por el tejido antes que por el nombre.
const muestras: Record<string, string> = {};
for (const { sistema, placas: delSistema } of porSistema) {
  const primera = delSistema[0];
  if (primera) muestras[sistema.id] = urlImagen(imagenesDe(primera.data)[0]!.archivo, 'miniatura');
}

const totalEstructuras = placas.reduce((n, p) => n + p.data.estructuras.length, 0);
const cifras = [
  { n: placas.length, etiqueta: placas.length === 1 ? 'lámina' : 'láminas' },
  { n: totalEstructuras, etiqueta: 'estructuras señaladas' },
  { n: SISTEMAS.length, etiqueta: 'sistemas' },
];
let contadorGlobal = 0;
---

<Base titulo="Atlas virtual de histologia">
  <section class="portada">
    <div class="portada__texto">
      <h1>Atlas virtual<br />de histología</h1>
      <p class="portada__entrada">
        {TOTAL_PLACAS_ESPERADAS} preparaciones teñidas con hematoxilina y eosina. Cada lámina se abre
        en un visor con zoom profundo y sus estructuras están señaladas una a una.
      </p>
    </div>

    <dl class="portada__cifras">
      {cifras.map((c) => (
        <div>
          <dt class="tabular-nums">{c.n}</dt>
          <dd>{c.etiqueta}</dd>
        </div>
      ))}
    </dl>
  </section>

  <section aria-labelledby="titulo-bandeja">
    <h2 id="titulo-bandeja" class="solo-lectores">Todas las láminas</h2>
    <BuscadorFiltros conteos={conteos} total={placas.length} muestras={muestras} />

    <div class="flex flex-col gap-14">
      {porSistema.map(({ sistema, placas: delSistema }) => (
        <section data-grupo-sistema={sistema.id} aria-labelledby={`sis-${sistema.id}`}>
          <header class="grupo">
            <h3 id={`sis-${sistema.id}`} class="grupo__titulo">
              <span class="grupo__punto" style={`background:${sistema.acento}`} aria-hidden="true" />
              {sistema.nombre}
            </h3>
            <span class="grupo__regla" aria-hidden="true"></span>
            <span class="grupo__cuenta tabular-nums">
              {delSistema.length}
              <span class="grupo__cuenta-palabra">
                {delSistema.length === 1 ? ' lámina' : ' láminas'}
              </span>
            </span>
            <p class="grupo__descripcion rotulo">{sistema.descripcion}</p>
          </header>

          <ul class="rejilla">
            {delSistema.map((p) => {
              contadorGlobal++;
              return (
                <Portaobjetos
                  placa={p.data}
                  prioridad={contadorGlobal <= 8}
                  tituloRepetido={repetidos.has(p.data.titulo)}
                />
              );
            })}
          </ul>
        </section>
      ))}
    </div>

    <p id="sin-resultados" hidden class="medida mt-16 text-texto-suave">
      Ninguna lámina coincide con la búsqueda. Prueba con el nombre del órgano o de una estructura.
    </p>
  </section>
</Base>

<style>
  /* --- Portada: el titulo y las cifras comparten una sola banda --- */
  .portada {
    display: grid;
    gap: 2rem;
    padding-block: clamp(2rem, 1rem + 4vw, 4rem) clamp(2rem, 1rem + 3.5vw, 3.25rem);
    border-bottom: 1px solid var(--atlas-borde);
    margin-bottom: clamp(1.75rem, 1rem + 2vw, 2.75rem);
  }
  @media (min-width: 900px) {
    .portada {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: end;
      gap: 3.5rem;
    }
  }

  .portada h1 {
    font-size: clamp(2.5rem, 1.2rem + 5vw, 4.4rem);
    font-weight: 400;
    line-height: 1.03;
    letter-spacing: -0.03em;
  }

  .portada__entrada {
    max-width: 46ch;
    margin-top: 1.4rem;
    font-size: clamp(0.98rem, 0.92rem + 0.3vw, 1.1rem);
    line-height: 1.65;
    color: var(--atlas-texto-suave);
  }

  /* Las cifras: columna a la derecha en escritorio, fila debajo en movil. */
  .portada__cifras {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem 2.25rem;
    margin: 0;
  }
  @media (min-width: 900px) {
    .portada__cifras {
      flex-direction: column;
      gap: 1.1rem;
      text-align: right;
      padding-bottom: 0.4rem;
    }
  }
  .portada__cifras dt {
    font-family: var(--font-serif);
    font-size: 1.85rem;
    font-weight: 400;
    line-height: 1;
    letter-spacing: -0.02em;
  }
  .portada__cifras dd {
    margin: 0.3rem 0 0;
    font-size: 0.76rem;
    line-height: 1.3;
    color: var(--atlas-texto-suave);
  }

  /* --- Cabecera de cada sistema --- */
  .grupo {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    column-gap: 0.9rem;
    row-gap: 0.45rem;
    margin-bottom: 1.4rem;
  }

  .grupo__titulo {
    display: flex;
    align-items: baseline;
    gap: 0.55rem;
    font-size: 1.28rem;
    font-weight: 450;
    letter-spacing: -0.015em;
  }

  .grupo__punto {
    height: 0.42rem;
    width: 0.42rem;
    flex: none;
    border-radius: 999px;
    translate: 0 -0.22rem;
  }

  .grupo__regla {
    height: 1px;
    background: var(--atlas-borde);
  }

  .grupo__cuenta {
    font-size: 0.78rem;
    color: var(--atlas-texto-suave);
    white-space: nowrap;
  }
  @media (max-width: 479px) {
    .grupo__cuenta-palabra {
      display: none;
    }
  }

  .grupo__descripcion {
    grid-column: 1 / -1;
    margin: 0;
  }
  @media (max-width: 639px) {
    .grupo__descripcion {
      display: none;
    }
  }

  /* --- Mosaico: la bandeja de preparaciones ---
     Columnas CSS en vez de rejilla. Asi cada lamina conserva su forma (la
     traquea es panoramica, el duodeno redondo) y el mosaico se cierra solo,
     sin recortar ninguna ni dejar huecos. --- */
  .rejilla {
    columns: 2;
    column-gap: 1.1rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .rejilla > :global(li) {
    margin-bottom: 1.6rem;
  }
  @media (min-width: 640px) {
    .rejilla {
      columns: 3;
      column-gap: 1.35rem;
    }
  }
  /* Tres columnas y no cuatro: con cuatro, el reparto secuencial de las
     columnas CSS dejaba huecos de media pantalla, y además la lámina se ve
     más grande, que es de lo que se trata. */
  @media (min-width: 1100px) {
    .rejilla {
      columns: 3;
      column-gap: 1.75rem;
    }
    .rejilla > :global(li) {
      margin-bottom: 2.25rem;
    }
  }
</style>
