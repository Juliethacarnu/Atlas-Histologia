---
// Mini quiz "¿qué estructura es esta?". Las preguntas se generan en el cliente
// a partir de las estructuras de la placa; el visor se acerca a la estructura
// preguntada y aquí solo se eligen los nombres.
import Icono from './Icono.astro';
---

<dialog id="quiz" class="quiz" aria-labelledby="quiz-titulo">
  <form method="dialog" class="contents">
    <header class="flex items-start gap-3">
      <div class="flex-1">
        <p class="quiz__progreso rotulo" id="quiz-progreso">Pregunta 1 de 1</p>
        <h2 id="quiz-titulo" class="font-serif text-xl font-medium">
          ¿Qué estructura señala el punto?
        </h2>
        <p id="quiz-instruccion" class="mt-0.5 text-sm text-texto-suave">
          Mira el punto que parpadea sobre la lámina y elige su nombre.
        </p>
      </div>
      <button class="quiz__cerrar" value="cerrar" aria-label="Cerrar el quiz">
        <Icono nombre="x" />
      </button>
    </header>

    <div class="quiz__barra" aria-hidden="true"><span id="quiz-barra"></span></div>

    <ul id="quiz-opciones" class="quiz__opciones" role="list"></ul>

    <p id="quiz-respuesta" class="quiz__respuesta" aria-live="polite"></p>

    <footer class="flex items-center gap-3 border-t border-borde pt-3">
      <p class="text-sm tabular-nums text-texto-suave">
        Aciertos: <span id="quiz-puntaje">0</span> de <span id="quiz-total">0</span>
      </p>
      <button type="button" id="quiz-siguiente" class="quiz__siguiente ml-auto" disabled>
        Siguiente pregunta
      </button>
    </footer>
  </form>
</dialog>

<style>
  /* El quiz no tapa la lamina: se abre como panel pegado abajo a la
     izquierda, sin velo, para que se vea el punto por el que se pregunta. */
  .quiz {
    position: fixed;
    inset: auto auto 4.5rem 1rem;
    margin: 0;
    z-index: 60;
    width: min(24rem, calc(100vw - 2rem));
    max-height: calc(100dvh - 6rem);
    overflow-y: auto;
    border: 1px solid var(--atlas-borde);
    border-radius: var(--radius-ficha);
    background: var(--atlas-superficie);
    color: var(--atlas-texto);
    padding: 1.25rem;
    box-shadow: 0 32px 70px -24px rgb(14 9 32 / 0.65);
  }
  @media (max-width: 767px) {
    .quiz {
      inset: auto 0.5rem 0.5rem 0.5rem;
      width: auto;
      max-height: 55dvh;
      padding: 1rem;
    }
  }
  .quiz__progreso {
    font-size: 0.7rem;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--atlas-texto-suave);
    margin-bottom: 0.15rem;
  }
  .quiz__barra {
    height: 4px;
    border-radius: 999px;
    background: var(--atlas-borde);
    overflow: hidden;
  }
  .quiz__barra span {
    display: block;
    height: 100%;
    width: 0;
    background: var(--marca-neon, var(--color-hematoxilina));
    transition: width 240ms ease;
  }
  .quiz__respuesta {
    min-height: 1.25rem;
    font-size: 0.9rem;
    font-weight: 500;
  }
  .quiz .contents {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .quiz__opciones {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .quiz__cerrar {
    display: grid;
    place-items: center;
    height: 1.9rem;
    width: 1.9rem;
    border-radius: var(--radius-chapa);
    font-size: 1.05rem;
    color: var(--atlas-texto-suave);
  }

  .quiz__siguiente {
    border-radius: 999px;
    background: var(--color-hematoxilina);
    color: #fff;
    padding: 0.4rem 0.9rem;
    font-size: 0.85rem;
  }
  .quiz__siguiente:disabled {
    opacity: 0.45;
  }
  :root[data-tema='oscuro'] .quiz__siguiente {
    background: var(--color-hematoxilina-claro);
    color: var(--color-nucleo);
  }
</style>

<!-- Las opciones del quiz las construye el cliente: sin ámbito no llegarían
     los estilos de arriba. -->
<style is:global>
  /* Mientras dura el quiz solo se ve el punto preguntado: los demas
     marcadores se apagan para que no haya duda de cual es. */
  :root[data-quiz] .indicador:not(.indicador--activa) {
    opacity: 0;
    pointer-events: none;
  }
  :root[data-quiz='pregunta'] .indicador--activa .indicador__rotulo,
  :root[data-quiz='pregunta'] .indicador--activa .indicador__guia {
    visibility: hidden;
  }
  #quiz-respuesta[data-estado='bien'] {
    color: var(--color-sis-digestivo);
  }
  #quiz-respuesta[data-estado='mal'] {
    color: var(--color-sis-sangre);
  }
  #quiz-opciones button {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    width: 100%;
    /* 52 px de alto minimo: se responde con el pulgar. */
    min-height: 52px;
    border-radius: var(--radius-ficha);
    border: 1px solid var(--atlas-borde-fuerte);
    padding: 0.55rem 0.75rem;
    text-align: left;
    font-size: 0.92rem;
    line-height: 1.35;
    color: var(--atlas-texto);
    transition:
      border-color 140ms,
      background-color 140ms;
  }
  #quiz-opciones button > span {
    flex: 1;
  }
  #quiz-opciones .quiz__letra {
    display: grid;
    place-items: center;
    flex: none;
    width: 1.6rem;
    height: 1.6rem;
    border-radius: 999px;
    border: 1px solid var(--atlas-borde-fuerte);
    font-size: 0.75rem;
  }
  #quiz-opciones button .icono {
    font-size: 1.15rem;
  }
  #quiz-opciones button:hover:not(:disabled) {
    border-color: var(--atlas-texto);
    background: var(--atlas-superficie-alta);
  }
  #quiz-opciones button:disabled {
    cursor: default;
  }
  /* El acierto y el fallo no se dicen solo con color: llevan icono, y la
     frase de debajo explica cual era la respuesta. */
  #quiz-opciones button[data-estado='bien'] {
    border-width: 2px;
    border-color: var(--color-sis-digestivo);
    background: color-mix(in srgb, var(--color-sis-digestivo) 12%, transparent);
  }
  #quiz-opciones button[data-estado='bien'] .icono {
    color: var(--color-sis-digestivo);
  }
  #quiz-opciones button[data-estado='mal'] {
    border-width: 2px;
    border-color: var(--color-sis-sangre);
    background: color-mix(in srgb, var(--color-sis-sangre) 12%, transparent);
  }
  #quiz-opciones button[data-estado='mal'] .icono {
    color: var(--color-sis-sangre);
  }
</style>
