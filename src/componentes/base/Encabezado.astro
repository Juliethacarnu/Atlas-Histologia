---
import { ruta } from '../../utils/ruta';
import InterruptorTema from '../InterruptorTema.astro';

interface Props {
  compacto?: boolean;
}
const { compacto = false } = Astro.props;
const aqui = Astro.url.pathname.replace(/\/$/, '');
// En movil no cabe «Créditos y fuentes»: cada enlace lleva su version corta.
const enlaces = [
  { href: ruta(), texto: 'Placas', corto: 'Placas' },
  { href: ruta('autores'), texto: 'Autores', corto: 'Autores' },
  { href: ruta('creditos'), texto: 'Créditos y fuentes', corto: 'Créditos' },
];
function activo(href: string) {
  return aqui === href.replace(/\/$/, '');
}
---

<header class:list={['cabecera', compacto && 'cabecera--compacta']}>
  <div class="contenedor-atlas flex items-center gap-2 sm:gap-3">
    <a href={ruta()} class="marca">
      {/* El sello del sistema de diseno: el campo del ocular con una celula
          tenida en H&E. Va en linea y pintado con los tokens del tema, que
          son exactamente los colores de marca-claro.svg y marca-oscuro.svg;
          asi no parpadea al cambiar de tema ni cuesta una peticion mas. */}
      <svg class="marca__sello" viewBox="0 0 32 32" aria-hidden="true" role="presentation">
        <circle cx="16" cy="16" r="12.5" fill="none" stroke="currentColor" stroke-width="3" />
        <ellipse
          cx="16"
          cy="16"
          rx="8.2"
          ry="5.3"
          transform="rotate(-35 16 16)"
          fill="var(--color-eosina)"
        />
        <circle cx="18.3" cy="14.4" r="2.7" fill="currentColor" />
      </svg>
      <span class="marca__nombre">Atlas de histología</span>
    </a>

    <nav class="navegacion" aria-label="Secciones">
      {enlaces.map((e) => (
        <a
          href={e.href}
          aria-current={activo(e.href) ? 'page' : undefined}
          class="navegacion__enlace"
        >
          <span class="max-sm:hidden">{e.texto}</span>
          <span class="sm:hidden">{e.corto}</span>
        </a>
      ))}
    </nav>

    <InterruptorTema />
  </div>
</header>

<style>
  /* Cabecera de publicacion: papel macizo y una regla doble debajo, como el
     filete que separa la cabecera de un pliego impreso. */
  .cabecera {
    position: sticky;
    top: 0;
    z-index: 30;
    padding-block: 0.7rem;
    background: color-mix(in srgb, var(--atlas-fondo) 92%, transparent);
    backdrop-filter: blur(12px) saturate(1.05);
    border-bottom: 1px solid var(--atlas-texto);
    box-shadow: 0 3px 0 -2px var(--atlas-borde-fuerte);
  }
  @media (min-width: 640px) {
    .cabecera {
      padding-block: 0.9rem;
    }
  }
  .cabecera--compacta {
    padding-block: 0.5rem;
  }

  /* --- Marca --- */
  .marca {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-right: auto;
    min-width: 0;
    text-decoration: none;
  }
  .marca__sello {
    height: 1.5rem;
    width: 1.5rem;
    flex: none;
    color: var(--atlas-texto);
  }

  .marca__nombre {
    font-family: var(--font-serif);
    font-size: 0.92rem;
    font-weight: 500;
    line-height: 1.2;
    letter-spacing: -0.015em;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  @media (min-width: 420px) {
    .marca__nombre {
      font-size: 1rem;
    }
  }
  @media (min-width: 640px) {
    .marca__nombre {
      font-size: 1.12rem;
    }
  }

  /* --- Navegacion: el activo se marca con un filo, no con una caja --- */
  .navegacion {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    flex: none;
  }
  @media (min-width: 640px) {
    .navegacion {
      gap: 1.1rem;
      margin-right: 0.5rem;
    }
  }

  .navegacion__enlace {
    position: relative;
    padding: 0.2rem 0.18rem;
    font-size: 0.78rem;
    color: var(--atlas-texto-suave);
    text-decoration: none;
    white-space: nowrap;
    transition: color 150ms;
  }
  @media (min-width: 640px) {
    .navegacion__enlace {
      padding-inline: 0;
      font-size: 0.88rem;
    }
  }
  .navegacion__enlace:hover {
    color: var(--atlas-texto);
  }
  .navegacion__enlace[aria-current='page'] {
    color: var(--atlas-texto);
  }
  /* El activo se marca con un filete grueso en eosina, no con una caja. */
  .navegacion__enlace[aria-current='page']::after {
    content: '';
    position: absolute;
    left: 0.18rem;
    right: 0.18rem;
    bottom: -0.2rem;
    height: 3px;
    background: var(--color-eosina);
  }
  @media (min-width: 640px) {
    .navegacion__enlace[aria-current='page']::after {
      left: 0;
      right: 0;
    }
  }
</style>

<script>
  /* Lo que queda pegado debajo de la cabecera (el indice de sistemas) necesita
     saber cuanto mide. Se mide en vez de suponerlo: depende de la tipografia
     ya cargada y del ancho de la pantalla. */
  const cabecera = document.querySelector('header.cabecera');
  function medir() {
    const alto = cabecera?.getBoundingClientRect().height ?? 0;
    if (alto > 0) document.documentElement.style.setProperty('--alto-cabecera', alto + 'px');
  }
  medir();
  window.addEventListener('resize', medir);
  document.fonts?.ready.then(medir);
</script>
