---
// Ficha de la estructura activa. El contenido lo rellena el cliente.
// Escritorio: tarjeta fija al pie del panel lateral.
// Móvil: hoja inferior (bottom sheet) que se desliza sobre el visor.
---

<section
  id="ficha-estructura"
  class="ficha"
  aria-labelledby="ficha-nombre"
  aria-live="polite"
  data-abierta="no"
  inert
>
  <div class="ficha__asa" aria-hidden="true"></div>

  <header class="flex items-start gap-2.5">
    <span id="ficha-numero" class="ficha__numero" aria-hidden="true">
      1
    </span>
    <div class="min-w-0 flex-1">
      <h3 id="ficha-nombre" class="font-serif text-[1.15rem] leading-snug font-medium"></h3>
      <p id="ficha-oculto" class="text-sm text-texto-suave" hidden>
        Nombre oculto en modo repaso.
        <button
          type="button"
          id="ficha-revelar"
          class="underline decoration-eosina underline-offset-3"
        >
          Revelar
        </button>
      </p>
    </div>
    <button type="button" id="ficha-cerrar" class="ficha__cerrar">
      <span class="solo-lectores">Cerrar la ficha</span>
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="m6 6 12 12M18 6 6 18" />
      </svg>
    </button>
  </header>

  <p id="ficha-descripcion" class="mt-2 text-[0.86rem] leading-relaxed text-texto-suave"></p>

  <div class="mt-3 flex flex-wrap items-center gap-2">
    <button type="button" id="ficha-anterior" class="ficha__accion">
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="m14 6-6 6 6 6" />
      </svg>
      Anterior
    </button>
    <button type="button" id="ficha-siguiente" class="ficha__accion">
      Siguiente
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="m10 6 6 6-6 6" />
      </svg>
    </button>
    <button type="button" id="ficha-video" class="ficha__accion" hidden>
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="M8 5.5v13l11-6.5z" />
      </svg>
      <span id="ficha-video-texto">Ver en el video</span>
    </button>
    <button type="button" id="ficha-enlace" class="ficha__accion ml-auto">
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="M10 13.5a3.5 3.5 0 0 0 5 0l3-3a3.54 3.54 0 0 0-5-5l-1 1" />
        <path d="M14 10.5a3.5 3.5 0 0 0-5 0l-3 3a3.54 3.54 0 0 0 5 5l1-1" />
      </svg>
      <span id="ficha-enlace-texto">Copiar enlace</span>
    </button>
  </div>
</section>

<style>
  .ficha[data-abierta='no'] {
    display: none;
  }

  .ficha {
    background: var(--atlas-superficie);
    border-top: 1px solid var(--atlas-borde);
    padding: 0.9rem 1rem 1.1rem;
  }

  .ficha__asa {
    display: none;
  }

  /* --- Móvil: hoja inferior --- */
  @media (max-width: 1023px) {
    .ficha {
      position: fixed;
      inset-inline: 0;
      bottom: 0;
      z-index: 45;
      max-height: 62dvh;
      overflow-y: auto;
      overscroll-behavior: contain;
      border-radius: 1rem 1rem 0 0;
      padding-bottom: calc(1.1rem + env(safe-area-inset-bottom));
      box-shadow: 0 -8px 30px -10px rgb(14 9 32 / 0.45);
      transform: translateY(0);
      transition: transform 240ms var(--ease-visor);
    }
    /* En móvil la hoja se desliza fuera de la pantalla en lugar de desaparecer. */
    .ficha[data-abierta='no'] {
      display: block;
      transform: translateY(105%);
      pointer-events: none;
      visibility: hidden;
    }
    .ficha__asa {
      display: block;
      width: 2.5rem;
      height: 0.25rem;
      margin: -0.25rem auto 0.6rem;
      border-radius: 999px;
      background: var(--atlas-borde);
    }
    @media (prefers-reduced-motion: reduce) {
      .ficha {
        transition: none;
      }
    }
  }

  /* --- Escritorio: al pie del panel lateral --- */
  @media (min-width: 1024px) {
    .ficha {
      position: sticky;
      bottom: 0;
      border-radius: 0.5rem;
      margin: 0.25rem 0.5rem 0.5rem;
      border: 1px solid var(--atlas-borde);
      background: var(--atlas-superficie-alta);
      box-shadow: 0 -6px 18px -12px rgb(14 9 32 / 0.5);
    }
  }

  .ficha__numero {
    display: grid;
    place-items: center;
    height: 1.6rem;
    min-width: 1.6rem;
    padding-inline: 0.25rem;
    flex: none;
    border-radius: 999px;
    background: var(--color-eosina);
    color: #fff;
    font-size: 0.8rem;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }

  .ficha__cerrar {
    display: grid;
    place-items: center;
    height: 1.75rem;
    width: 1.75rem;
    flex: none;
    border-radius: 0.375rem;
    color: var(--atlas-texto-suave);
  }
  .ficha__cerrar:hover {
    background: var(--atlas-fondo);
    color: var(--atlas-texto);
  }
  .ficha__cerrar svg {
    width: 1rem;
    height: 1rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
  }

  .ficha__accion {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    border-radius: 0.4rem;
    border: 1px solid var(--atlas-borde);
    padding: 0.25rem 0.55rem;
    font-size: 0.76rem;
    color: var(--atlas-texto-suave);
    transition:
      color 140ms,
      background-color 140ms;
  }
  .ficha__accion svg {
    width: 0.85rem;
    height: 0.85rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  #ficha-video svg {
    fill: currentColor;
    stroke: none;
  }
  .ficha__accion:hover:not(:disabled) {
    background: var(--atlas-fondo);
    color: var(--atlas-texto);
  }
  .ficha__accion:disabled {
    opacity: 0.4;
  }
</style>
