---
// Ficha de la estructura activa. El contenido lo rellena el cliente.
// Escritorio: tarjeta fija al pie del panel lateral.
// Móvil: hoja inferior (bottom sheet) que se desliza sobre el visor.
import Icono from './Icono.astro';
---

<section
  id="ficha-estructura"
  class="ficha"
  aria-labelledby="ficha-nombre"
  aria-live="polite"
  data-abierta="no"
  inert
>
  {/* En movil el tirador no es un adorno: sube la hoja a pantalla casi
      completa y la vuelve a bajar. Tambien se puede arrastrar. */}
  <button type="button" id="ficha-altura" class="ficha__asa">
    <span class="solo-lectores">Subir o bajar la ficha</span>
    <span class="ficha__asa-barra" aria-hidden="true"></span>
  </button>

  <header class="flex items-start gap-2.5">
    <span id="ficha-numero" class="ficha__numero" aria-hidden="true">
      1
    </span>
    <div class="min-w-0 flex-1">
      <h3 id="ficha-nombre" class="font-serif text-[1.15rem] leading-snug font-medium"></h3>
      <p id="ficha-oculto" class="text-sm text-texto-suave" hidden>
        Nombre oculto en modo repaso.
        <button
          type="button"
          id="ficha-revelar"
          class="underline decoration-eosina underline-offset-3"
        >
          Revelar
        </button>
      </p>
    </div>
    <button type="button" id="ficha-cerrar" class="ficha__cerrar">
      <span class="solo-lectores">Cerrar la ficha</span>
      <Icono nombre="x" />
    </button>
  </header>

  <p id="ficha-descripcion" class="mt-2 text-[0.86rem] leading-relaxed text-texto-suave" hidden></p>

  <div class="mt-3 flex flex-wrap items-center gap-2">
    <button type="button" id="ficha-anterior" class="ficha__accion">
      <Icono nombre="caret-left" peso="bold" />
      Anterior
    </button>
    <button type="button" id="ficha-siguiente" class="ficha__accion">
      Siguiente
      <Icono nombre="caret-right" peso="bold" />
    </button>
    <button type="button" id="ficha-video" class="ficha__accion" hidden>
      <Icono nombre="play" peso="fill" />
      <span id="ficha-video-texto">Ver en el video</span>
    </button>
    <button type="button" id="ficha-enlace" class="ficha__accion ml-auto">
      <Icono nombre="link-simple" />
      <span id="ficha-enlace-texto">Copiar enlace</span>
    </button>
  </div>
</section>

<style>
  .ficha[data-abierta='no'] {
    display: none;
  }

  .ficha {
    background: var(--atlas-superficie);
    border-top: 1px solid var(--atlas-borde);
    padding: 0.9rem 1rem 1.1rem;
  }

  .ficha__asa {
    display: none;
  }

  /* --- Móvil: hoja inferior --- */
  @media (max-width: 1023px) {
    .ficha {
      position: fixed;
      inset-inline: 0;
      bottom: 0;
      z-index: 45;
      /* Dos paradas: la de reposo mide lo que mide su contenido, sin pasar
         de media pantalla, y la alta se estira para leer una descripcion
         larga. Una ficha de dos lineas que ocupase 62dvh seria medio
         folio en blanco tapando la lamina. */
      height: auto;
      max-height: 62dvh;
      overflow-y: auto;
      overscroll-behavior: contain;
      border-radius: var(--radius-hoja) var(--radius-hoja) 0 0;
      padding-top: 0.35rem;
      padding-bottom: calc(1.1rem + env(safe-area-inset-bottom));
      box-shadow: var(--atlas-sombra-hoja);
      transform: translateY(0);
      transition:
        transform 240ms var(--ease-visor),
        height 240ms var(--ease-visor);
      touch-action: pan-y;
    }
    .ficha[data-altura='alta'] {
      height: calc(100dvh - 3rem);
      max-height: none;
    }
    /* En móvil la hoja se desliza fuera de la pantalla en lugar de desaparecer. */
    .ficha[data-abierta='no'] {
      display: block;
      transform: translateY(105%);
      pointer-events: none;
      visibility: hidden;
    }
    .ficha__asa {
      display: grid;
      place-items: center;
      width: 100%;
      /* Un tirador se agarra: el area util llega a 44 px aunque la barra
         mida 4, porque es lo primero que toca el pulgar. */
      height: var(--medida-tactil);
      margin-top: -0.35rem;
    }
    .ficha__asa-barra {
      display: block;
      width: 2.5rem;
      height: 0.25rem;
      border-radius: 999px;
      background: var(--atlas-borde-fuerte);
    }
    @media (prefers-reduced-motion: reduce) {
      .ficha {
        transition: none;
      }
    }
  }

  /* --- Escritorio: al pie del panel lateral --- */
  @media (min-width: 1024px) {
    .ficha {
      position: sticky;
      bottom: 0;
      border-radius: var(--radius-ficha);
      margin: 0.25rem 0.5rem 0.5rem;
      border: 1px solid var(--atlas-borde);
      background: var(--atlas-superficie-alta);
      box-shadow: 0 -6px 18px -12px rgb(14 9 32 / 0.5);
    }
  }

  .ficha__numero {
    display: grid;
    place-items: center;
    height: 1.6rem;
    min-width: 1.6rem;
    padding-inline: 0.25rem;
    flex: none;
    border-radius: 999px;
    border: 2px solid var(--atlas-texto);
    background: var(--atlas-texto);
    color: var(--atlas-fondo);
    font-size: 0.8rem;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }

  .ficha__cerrar {
    display: grid;
    place-items: center;
    height: 1.75rem;
    width: 1.75rem;
    flex: none;
    border-radius: var(--radius-chapa);
    font-size: 1.05rem;
    color: var(--atlas-texto-suave);
  }
  .ficha__cerrar:hover {
    background: var(--atlas-fondo);
    color: var(--atlas-texto);
  }


  @media (max-width: 1023px) {
    #ficha-anterior,
    #ficha-siguiente {
      display: none;
    }
  }

  .ficha__accion {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    border-radius: var(--radius-chapa);
    border: 1px solid var(--atlas-borde);
    padding: 0.25rem 0.55rem;
    font-size: 0.76rem;
    color: var(--atlas-texto-suave);
    transition:
      color 140ms,
      background-color 140ms;
  }
  .ficha__accion .icono {
    font-size: 0.95rem;
  }
  .ficha__accion:hover:not(:disabled) {
    background: var(--atlas-fondo);
    color: var(--atlas-texto);
  }
  .ficha__accion:disabled {
    opacity: 0.4;
  }
</style>
