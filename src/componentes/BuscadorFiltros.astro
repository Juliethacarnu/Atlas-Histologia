---
import { SISTEMAS } from '../datos/sistemas';

interface Props {
  conteos: Record<string, number>;
  total: number;
}
const { conteos, total } = Astro.props;
---

<div class="buscador">
  <div class="buscador__campo">
    <label for="buscador" class="solo-lectores">Buscar placa o estructura</label>
    <svg
      class="buscador__lupa"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.7"
      aria-hidden="true"
    >
      <circle cx="11" cy="11" r="6.5"></circle>
      <path d="m16 16 4.5 4.5"></path>
    </svg>
    <input
      type="search"
      id="buscador"
      placeholder="Buscar una lámina o una estructura: duodeno, glándulas de Brunner…"
      autocomplete="off"
    />
    <p class="buscador__conteo tabular-nums" aria-live="polite" id="conteo-resultados">
      {total}
    </p>
  </div>

  <div role="group" aria-label="Filtrar por sistema" class="filtros">
    <button type="button" class="chip-sistema" data-filtro="todos" aria-pressed="true">
      Todos <span class="chip-sistema__n tabular-nums">{total}</span>
    </button>
    {SISTEMAS.map((s) => (
      <button
        type="button"
        class="chip-sistema"
        data-filtro={s.id}
        aria-pressed="false"
        style={`--acento-sistema: ${s.acento}`}
      >
        <span class="punto-acento" aria-hidden="true" />
        {s.nombre} <span class="chip-sistema__n tabular-nums">{conteos[s.id] ?? 0}</span>
      </button>
    ))}
  </div>
</div>

<style>
  .buscador {
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
    margin-bottom: 2.75rem;
  }

  /* El campo: un rectángulo de papel con filo de pelo, ancho completo. */
  .buscador__campo {
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.65rem;
    border: 1px solid var(--atlas-borde);
    border-radius: var(--radius-chapa);
    background: var(--atlas-superficie);
    padding: 0 0.9rem;
    transition: border-color 160ms;
  }
  .buscador__campo:focus-within {
    border-color: var(--atlas-borde-fuerte);
  }

  .buscador__lupa {
    height: 1.05rem;
    width: 1.05rem;
    flex: none;
    color: var(--atlas-texto-suave);
  }

  .buscador__campo input {
    flex: 1;
    min-width: 0;
    background: transparent;
    padding-block: 0.8rem;
    font-size: 0.92rem;
    color: var(--atlas-texto);
  }
  .buscador__campo input::placeholder {
    color: color-mix(in srgb, var(--atlas-texto-suave) 70%, transparent);
  }
  .buscador__campo input:focus {
    outline: none;
  }
  .buscador__campo:focus-within {
    outline: 2px solid var(--color-eosina);
    outline-offset: 2px;
  }
  /* La X nativa de Chrome no sigue el tema; se usa Escape o se borra a mano. */
  .buscador__campo input::-webkit-search-cancel-button {
    appearance: none;
  }

  .buscador__conteo {
    flex: none;
    font-size: 0.78rem;
    color: var(--atlas-texto-suave);
  }

  /* Los filtros no se envuelven: en móvil se arrastran de lado. */
  .filtros {
    display: flex;
    gap: 1.4rem;
    overflow-x: auto;
    scrollbar-width: none;
    margin-inline: -1.25rem;
    padding-inline: 1.25rem;
    padding-bottom: 0.1rem;
  }
  .filtros::-webkit-scrollbar {
    display: none;
  }
  @media (min-width: 900px) {
    .filtros {
      flex-wrap: wrap;
      overflow: visible;
      margin-inline: 0;
      padding-inline: 0;
    }
  }

  .chip-sistema {
    display: inline-flex;
    align-items: baseline;
    gap: 0.4rem;
    flex: none;
    padding-bottom: 0.3rem;
    font-size: 0.85rem;
    white-space: nowrap;
    color: var(--atlas-texto-suave);
    border-bottom: 1.5px solid transparent;
    transition:
      color 150ms,
      border-color 150ms;
  }
  .chip-sistema:hover {
    color: var(--atlas-texto);
  }
  .chip-sistema[aria-pressed='true'] {
    color: var(--atlas-texto);
    border-bottom-color: var(--acento-sistema, var(--color-eosina));
  }
  .chip-sistema__n {
    /* Más pequeño, pero sin rebajar la opacidad: el contraste debe aguantar. */
    font-size: 0.7rem;
  }
  .punto-acento {
    height: 0.32rem;
    width: 0.32rem;
    border-radius: 999px;
    background: var(--acento-sistema, var(--atlas-texto-suave));
    translate: 0 -0.12rem;
  }
</style>

<script>
  const buscador = document.getElementById('buscador') as HTMLInputElement | null;
  const conteo = document.getElementById('conteo-resultados');
  const chips = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-filtro]'));
  const items = Array.from(document.querySelectorAll<HTMLElement>('[data-placa]'));
  const grupos = Array.from(document.querySelectorAll<HTMLElement>('[data-grupo-sistema]'));
  const vacio = document.getElementById('sin-resultados');

  let filtro = 'todos';

  function normalizar(t: string) {
    return t.normalize('NFD').replace(/\p{M}/gu, '').toLowerCase().trim();
  }

  function aplicar() {
    const consulta = normalizar(buscador?.value ?? '');
    let visibles = 0;

    for (const item of items) {
      const coincideSistema = filtro === 'todos' || item.dataset.sistema === filtro;
      const coincideTexto = consulta === '' || (item.dataset.busqueda ?? '').includes(consulta);
      const visible = coincideSistema && coincideTexto;
      item.hidden = !visible;
      if (visible) visibles++;
    }

    // Oculta los encabezados de sistema que quedan sin placas.
    for (const grupo of grupos) {
      const algunaVisible =
        grupo.querySelectorAll<HTMLElement>('[data-placa]:not([hidden])').length > 0;
      grupo.hidden = !algunaVisible;
    }

    if (conteo) {
      conteo.textContent = String(visibles);
      conteo.setAttribute(
        'aria-label',
        visibles === 0
          ? 'Ninguna placa coincide'
          : `${visibles} ${visibles === 1 ? 'placa' : 'placas'}`,
      );
    }
    vacio?.toggleAttribute('hidden', visibles !== 0);

    const url = new URL(window.location.href);
    if (filtro === 'todos') url.searchParams.delete('sistema');
    else url.searchParams.set('sistema', filtro);
    if (consulta === '') url.searchParams.delete('q');
    else url.searchParams.set('q', buscador?.value ?? '');
    history.replaceState(null, '', url);
  }

  for (const chip of chips) {
    chip.addEventListener('click', () => {
      filtro = chip.dataset.filtro ?? 'todos';
      for (const otro of chips) otro.setAttribute('aria-pressed', String(otro === chip));
      aplicar();
    });
  }

  buscador?.addEventListener('input', aplicar);

  // Estado inicial desde la URL, para poder compartir un filtro.
  const inicial = new URL(window.location.href).searchParams;
  const sistemaInicial = inicial.get('sistema');
  const qInicial = inicial.get('q');
  if (qInicial && buscador) buscador.value = qInicial;
  if (sistemaInicial) {
    const chip = chips.find((c) => c.dataset.filtro === sistemaInicial);
    if (chip) {
      filtro = sistemaInicial;
      for (const otro of chips) otro.setAttribute('aria-pressed', String(otro === chip));
    }
  }
  if (qInicial || sistemaInicial) aplicar();
</script>
