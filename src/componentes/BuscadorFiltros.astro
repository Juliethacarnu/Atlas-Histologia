---
import { SISTEMAS } from '../datos/sistemas';
import Icono from './Icono.astro';

interface Props {
  conteos: Record<string, number>;
  total: number;
  /** Miniatura de una lamina de cada sistema, para la entrada del indice. */
  muestras?: Record<string, string>;
}
const { conteos, total, muestras = {} } = Astro.props;
---

<div class="buscador">
  <label for="buscador" class="solo-lectores">Buscar placa o estructura</label>
  <Icono nombre="magnifying-glass" clase="buscador__lupa" />
  <input
    type="search"
    id="buscador"
    placeholder="Buscar una lámina o una estructura: duodeno, glándulas de Brunner…"
    autocomplete="off"
  />
  <p class="buscador__conteo tabular-nums" aria-live="polite" id="conteo-resultados">
    {total}
  </p>
</div>

{/* En escritorio es una columna fija a la izquierda; en movil, una tira que
    se arrastra de lado. Es el mismo control: filtra la bandeja. */}
<nav class="indice" aria-label="Filtrar por sistema">
  <p class="indice__rotulo rotulo">Sistemas</p>
  <div class="indice__lista" role="group">
    <button type="button" class="sistema" data-filtro="todos" aria-pressed="true">
      <span class="sistema__muestra sistema__muestra--todos" aria-hidden="true"></span>
      <span class="sistema__texto">
        <span class="sistema__nombre">Todos</span>
        <span class="sistema__n tabular-nums">{total}</span>
      </span>
    </button>
    {SISTEMAS.map((s) => (
      <button
        type="button"
        class="sistema"
        data-filtro={s.id}
        aria-pressed="false"
        style={`--acento-sistema: ${s.acento}; --senal: ${(conteos[s.id] ?? 0) / 15}`}
      >
        {muestras[s.id] ? (
          <img
            class="sistema__muestra"
            src={muestras[s.id]}
            alt=""
            aria-hidden="true"
            loading="lazy"
          />
        ) : (
          <span class="sistema__muestra" aria-hidden="true"></span>
        )}
        <span class="sistema__texto">
          <span class="sistema__nombre">{s.nombre}</span>
          <span class="sistema__n tabular-nums">{conteos[s.id] ?? 0}</span>
        </span>
      </button>
    ))}
  </div>
</nav>

<style>
  /* --- El campo de busqueda: una linea de papel pautado, sin caja --- */
  .buscador {
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.7rem;
    border-bottom: 1px solid var(--atlas-texto);
    padding: 0 0.15rem 0.55rem;
  }
  .buscador__lupa {
    font-size: 1.1rem;
    color: var(--atlas-texto-suave);
  }
  .buscador input {
    flex: 1;
    min-width: 0;
    background: transparent;
    font-family: var(--font-serif);
    font-size: 1.05rem;
    color: var(--atlas-texto);
  }
  .buscador input::placeholder {
    color: color-mix(in srgb, var(--atlas-texto-suave) 72%, transparent);
  }
  .buscador input:focus {
    outline: none;
  }
  .buscador:focus-within {
    border-bottom-color: var(--color-eosina);
  }
  /* La X nativa de Chrome no sigue el tema; se usa Escape o se borra a mano. */
  .buscador input::-webkit-search-cancel-button {
    appearance: none;
  }
  .buscador__conteo {
    flex: none;
    font-size: 0.78rem;
    color: var(--atlas-texto-suave);
  }

  /* --- El indice de sistemas --- */
  .indice__rotulo {
    display: none;
  }

  .indice__lista {
    display: flex;
    gap: 0.4rem;
    overflow-x: auto;
    scrollbar-width: none;
    /* En movil la tira llega hasta los bordes de la pantalla. */
    margin-inline: -1.25rem;
    padding-inline: 1.25rem;
    padding-bottom: 0.15rem;
  }
  .indice__lista::-webkit-scrollbar {
    display: none;
  }

  .sistema {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    flex: none;
    border: 1px solid var(--atlas-borde);
    border-radius: 999px;
    background: var(--atlas-superficie);
    padding: 0.2rem 0.75rem 0.2rem 0.2rem;
    font-size: 0.82rem;
    white-space: nowrap;
    color: var(--atlas-texto-suave);
    transition:
      color 150ms,
      border-color 150ms,
      background-color 150ms;
  }
  .sistema__texto {
    display: flex;
    align-items: baseline;
    gap: 0.4rem;
  }
  .sistema:hover {
    color: var(--atlas-texto);
    border-color: var(--atlas-borde-fuerte);
  }
  .sistema[aria-pressed='true'] {
    color: var(--atlas-texto);
    border-color: var(--atlas-texto);
  }

  /* Un recorte de una lamina del sistema, dentro de la propia entrada. */
  .sistema__muestra {
    height: 1.6rem;
    width: 1.6rem;
    flex: none;
    border-radius: 999px;
    object-fit: cover;
    background: var(--atlas-fondo);
    box-shadow: inset 0 0 0 1px rgb(28 26 22 / 0.14);
  }
  .sistema__muestra--todos {
    /* «Todos» no tiene lamina propia: lleva el disco del portaobjetos. */
    background:
      radial-gradient(circle at 50% 50%, var(--color-eosina-tenue) 40%, transparent 41%),
      var(--atlas-fondo);
  }

  .sistema__n {
    font-size: 0.72rem;
    color: var(--atlas-texto-suave);
    font-variant-numeric: tabular-nums;
  }

  /* --- Escritorio: el indice baja a una columna fija a la izquierda --- */
  @media (min-width: 1100px) {
    .indice {
      position: sticky;
      top: calc(var(--alto-cabecera, 4rem) + 1.5rem);
      align-self: start;
    }
    .indice__rotulo {
      display: block;
      margin-bottom: 0.7rem;
      padding-bottom: 0.45rem;
      border-bottom: 1px solid var(--atlas-borde);
    }
    .indice__lista {
      flex-direction: column;
      gap: 0;
      overflow: visible;
      margin-inline: 0;
      padding-inline: 0;
    }
    .sistema {
      width: 100%;
      border: 0;
      border-radius: 0;
      background: transparent;
      padding: 0.45rem 0 0.45rem 0.65rem;
      /* El filete de la izquierda es lo que marca el sistema elegido. */
      box-shadow: inset 2px 0 0 transparent;
      white-space: normal;
      text-align: left;
    }
    .sistema__texto {
      flex: 1;
      align-items: baseline;
      justify-content: space-between;
      gap: 0.5rem;
    }
    .sistema__nombre {
      text-wrap: balance;
    }
    .sistema:hover {
      background: var(--atlas-superficie);
      box-shadow: inset 2px 0 0 var(--atlas-borde-fuerte);
    }
    .sistema[aria-pressed='true'] {
      background: var(--atlas-superficie);
      box-shadow: inset 2px 0 0 var(--color-eosina);
    }
    .sistema__muestra {
      height: 1.5rem;
      width: 1.5rem;
    }
  }
</style>

<script>
  const buscador = document.getElementById('buscador') as HTMLInputElement | null;
  const conteo = document.getElementById('conteo-resultados');
  const chips = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-filtro]'));
  const items = Array.from(document.querySelectorAll<HTMLElement>('[data-placa]'));
  const grupos = Array.from(document.querySelectorAll<HTMLElement>('[data-grupo-sistema]'));
  const vacio = document.getElementById('sin-resultados');
  const vacioTermino = document.getElementById('vacio-termino');
  const vacioCerca = document.getElementById('vacio-cerca');
  const vacioLista = document.getElementById('vacio-lista');
  const vacioLimpiar = document.getElementById('vacio-limpiar');

  let filtro = 'todos';

  function normalizar(t: string) {
    return t.normalize('NFD').replace(/\p{M}/gu, '').toLowerCase().trim();
  }

  function aplicar() {
    const consulta = normalizar(buscador?.value ?? '');
    let visibles = 0;

    for (const item of items) {
      const coincideSistema = filtro === 'todos' || item.dataset.sistema === filtro;
      const coincideTexto = consulta === '' || (item.dataset.busqueda ?? '').includes(consulta);
      const visible = coincideSistema && coincideTexto;
      item.hidden = !visible;
      if (visible) visibles++;
    }

    // Oculta los encabezados de sistema que quedan sin placas.
    for (const grupo of grupos) {
      const algunaVisible =
        grupo.querySelectorAll<HTMLElement>('[data-placa]:not([hidden])').length > 0;
      grupo.hidden = !algunaVisible;
    }

    if (conteo) {
      conteo.textContent = String(visibles);
      conteo.setAttribute(
        'aria-label',
        visibles === 0
          ? 'Ninguna placa coincide'
          : `${visibles} ${visibles === 1 ? 'placa' : 'placas'}`,
      );
    }
    vacio?.toggleAttribute('hidden', visibles !== 0);
    if (visibles === 0) pintarSugerencias(buscador?.value ?? '', consulta);

    const url = new URL(window.location.href);
    if (filtro === 'todos') url.searchParams.delete('sistema');
    else url.searchParams.set('sistema', filtro);
    if (consulta === '') url.searchParams.delete('q');
    else url.searchParams.set('q', buscador?.value ?? '');
    history.replaceState(null, '', url);
  }

  /**
   * Las tres laminas mas cercanas a lo que se escribio. Se recorta la
   * consulta por el final hasta que algo coincide: asi «glandulas de brunne»
   * o «duoden» siguen llevando a su lamina en vez de a un callejon.
   */
  function pintarSugerencias(crudo: string, consulta: string) {
    if (vacioTermino) vacioTermino.textContent = crudo.trim();
    if (!vacioLista || !vacioCerca) return;

    let cerca: HTMLElement[] = [];
    for (let largo = consulta.length - 1; largo >= 3 && cerca.length === 0; largo--) {
      const trozo = consulta.slice(0, largo);
      cerca = items.filter((i) => (i.dataset.busqueda ?? '').includes(trozo)).slice(0, 3);
    }

    vacioLista.textContent = '';
    for (const item of cerca) {
      const enlace = item.querySelector('a')?.getAttribute('href');
      if (!enlace) continue;
      const li = document.createElement('li');
      const a = document.createElement('a');
      a.href = enlace;
      const nombre = document.createElement('span');
      nombre.className = 'vacio__nombre';
      nombre.textContent = item.dataset.titulo ?? '';
      const donde = document.createElement('span');
      donde.className = 'vacio__donde';
      donde.textContent = item.dataset.donde ?? '';
      a.append(nombre, donde);
      li.appendChild(a);
      vacioLista.appendChild(li);
    }
    vacioCerca.toggleAttribute('hidden', cerca.length === 0);
  }

  vacioLimpiar?.addEventListener('click', () => {
    if (buscador) buscador.value = '';
    filtro = 'todos';
    for (const otro of chips) {
      otro.setAttribute('aria-pressed', String(otro.dataset.filtro === 'todos'));
    }
    aplicar();
    buscador?.focus();
  });

  for (const chip of chips) {
    chip.addEventListener('click', () => {
      filtro = chip.dataset.filtro ?? 'todos';
      for (const otro of chips) otro.setAttribute('aria-pressed', String(otro === chip));
      aplicar();
    });
  }

  buscador?.addEventListener('input', aplicar);

  // Estado inicial desde la URL, para poder compartir un filtro.
  const inicial = new URL(window.location.href).searchParams;
  const sistemaInicial = inicial.get('sistema');
  const qInicial = inicial.get('q');
  if (qInicial && buscador) buscador.value = qInicial;
  if (sistemaInicial) {
    const chip = chips.find((c) => c.dataset.filtro === sistemaInicial);
    if (chip) {
      filtro = sistemaInicial;
      for (const otro of chips) otro.setAttribute('aria-pressed', String(otro === chip));
    }
  }
  if (qInicial || sistemaInicial) aplicar();
</script>
