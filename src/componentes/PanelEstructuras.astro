---
import type { Placa } from '../utils/placas';
import { nombreSistema, acentoSistema } from '../datos/sistemas';
import FichaEstructura from './FichaEstructura.astro';

interface Props {
  placa: Placa;
}
const { placa } = Astro.props;
const acento = acentoSistema(placa.sistema);
const estructuras = [...placa.estructuras].sort((a, b) => a.numero - b.numero);
// Una estructura puede existir en la lista antes de estar señalada sobre la lámina.
const sinMarcador = (e: (typeof estructuras)[number]) =>
  e.x === undefined && e.puntos.length === 0;
---

<aside class="panel-estructuras" aria-labelledby="titulo-panel">
  <div class="flex flex-col gap-3 border-b border-borde px-4 pt-4 pb-3">
    <div>
      <p class="flex items-center gap-1.5 text-[0.72rem] text-texto-suave">
        <span
          class="h-1.5 w-1.5 rounded-full"
          style={`background:${acento}`}
          aria-hidden="true"
        ></span>
        {nombreSistema(placa.sistema)}
      </p>
      <h2 id="titulo-panel" class="mt-0.5 font-serif text-xl leading-tight font-medium">
        {placa.titulo}
      </h2>
    </div>

    <!-- Los mismos campos de la diapositiva, en el mismo orden. -->
    <dl class="ficha-campos">
      <dt>Órgano / Tejido</dt>
      <dd>{placa.organo || <span class="pendiente">sin indicar</span>}</dd>

      <dt>Tinción</dt>
      <dd>{placa.tincion || <span class="pendiente">sin indicar</span>}</dd>

      <dt>Aumento</dt>
      <dd>
        {placa.aumentos.length > 0 ? (
          placa.aumentos.join(' · ')
        ) : (
          <span class="pendiente">sin indicar</span>
        )}
      </dd>
    </dl>

    {placa.descripcionGeneral && (
      <div>
        <h3 class="mb-1 font-sans text-[0.8rem] font-normal text-texto-suave">Descripción</h3>
        {/* Las descripciones rondan los 1000 caracteres: se recortan para que
            la lista de estructuras no quede enterrada. */}
        <p id="descripcion-placa" class="descripcion" data-abierta="no">
          {placa.descripcionGeneral}
        </p>
        <button type="button" id="alternar-descripcion" class="enlace-sutil" aria-expanded="false">
          <span>Leer la descripción completa</span>
        </button>
      </div>
    )}

    <div class="flex flex-wrap gap-2">
      <button
        type="button"
        id="boton-repaso"
        class="boton-panel"
        aria-pressed="false"
        aria-keyshortcuts="R"
      >
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M2.5 12S6 5.5 12 5.5 21.5 12 21.5 12 18 18.5 12 18.5 2.5 12 2.5 12Z" />
          <circle cx="12" cy="12" r="2.6" />
          <path d="m4 20 16-16" />
        </svg>
        Modo repaso
      </button>
      <button type="button" id="boton-quiz" class="boton-panel" disabled>
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M9.2 9a2.9 2.9 0 1 1 4 2.7c-.8.4-1.2 1-1.2 1.9v.4" />
          <circle cx="12" cy="17.6" r="0.9" fill="currentColor" stroke="none" />
          <circle cx="12" cy="12" r="9" />
        </svg>
        Mini quiz
      </button>
    </div>
  </div>

  <div class="flex items-baseline justify-between px-4 pt-3 pb-1">
    <h3 class="font-serif text-base font-medium">Estructuras importantes</h3>
    <span class="text-xs tabular-nums text-texto-suave">{estructuras.length}</span>
  </div>

  {estructuras.length === 0 ? (
    <p class="px-4 pb-4 text-sm text-texto-suave">
      Esta placa todavía no tiene estructuras anotadas. Usa la herramienta
      <code class="mx-1 rounded bg-superficie-alta px-1 py-0.5 text-[0.78rem]">/admin/anotar</code>
      en modo desarrollo.
    </p>
  ) : (
    <ol class="lista-estructuras" role="list">
      {estructuras.map((e) => (
        <li>
          <button type="button" class="fila-estructura" data-fila={e.id} aria-current="false">
            <span class="numero-fila" aria-hidden="true">
              {e.numero}
            </span>
            <span class="flex-1 text-left">
              <span class="nombre-estructura" data-nombre>
                {e.nombre}
                {sinMarcador(e) && (
                  <span class="sin-marcador" title="Todavía no está señalada sobre la lámina">
                    sin marcador
                  </span>
                )}
              </span>
              <span class="nombre-oculto" data-oculto hidden aria-hidden="true">
                Pulsa para revelar
              </span>
            </span>
          </button>
        </li>
      ))}
    </ol>
  )}

  <p class="mt-auto px-4 py-3 text-[0.7rem] leading-relaxed text-texto-suave">
    Atajos: <kbd>←</kbd> <kbd>→</kbd> placa anterior y siguiente · <kbd>+</kbd> <kbd>−</kbd>
    <kbd>0</kbd> zoom · <kbd>M</kbd> avatar · <kbd>R</kbd> repaso
  </p>

  <FichaEstructura />
</aside>

<style>
  .panel-estructuras {
    display: flex;
    flex-direction: column;
    background: var(--atlas-fondo);
    border-top: 1px solid var(--atlas-borde);
  }

  /* En pantallas grandes el panel flota sobre el campo oscuro del visor. */
  @media (min-width: 1024px) {
    .panel-estructuras {
      position: absolute;
      inset-block: 0.75rem;
      right: 0.75rem;
      z-index: 20;
      width: 21.5rem;
      border-top: 0;
      border-radius: 0.75rem;
      background: color-mix(in srgb, var(--atlas-superficie) 90%, transparent);
      backdrop-filter: blur(14px) saturate(1.1);
      border: 1px solid color-mix(in srgb, var(--atlas-borde) 70%, transparent);
      box-shadow:
        0 1px 2px rgb(14 9 32 / 0.25),
        0 14px 40px -14px rgb(14 9 32 / 0.5);
      overflow-y: auto;
      overscroll-behavior: contain;
    }
  }

  .descripcion {
    font-size: 0.84rem;
    line-height: 1.55;
    color: var(--atlas-texto-suave);
    overflow: hidden;
  }
  .descripcion[data-abierta='no'] {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 5;
    line-clamp: 5;
  }

  .enlace-sutil {
    margin-top: 0.3rem;
    font-size: 0.76rem;
    color: var(--atlas-acento);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-color: var(--atlas-borde);
  }
  .enlace-sutil:hover {
    text-decoration-color: var(--color-eosina);
  }

  .ficha-campos {
    display: grid;
    grid-template-columns: auto 1fr;
    column-gap: 0.75rem;
    row-gap: 0.3rem;
    margin: 0;
    font-size: 0.8rem;
    line-height: 1.4;
  }
  .ficha-campos dt {
    color: var(--atlas-texto-suave);
    white-space: nowrap;
  }
  .ficha-campos dd {
    margin: 0;
    color: var(--atlas-texto);
  }
  .pendiente {
    font-style: italic;
    color: var(--atlas-texto-suave);
    opacity: 0.75;
  }

  .boton-panel {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    border-radius: 0.5rem;
    border: 1px solid var(--atlas-borde);
    background: var(--atlas-superficie-alta);
    padding: 0.3rem 0.65rem;
    font-size: 0.78rem;
    color: var(--atlas-texto-suave);
    transition:
      color 140ms,
      border-color 140ms,
      background-color 140ms;
  }
  .boton-panel svg {
    width: 0.95rem;
    height: 0.95rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.7;
    stroke-linecap: round;
  }
  .boton-panel:hover:not(:disabled) {
    color: var(--atlas-texto);
  }
  .boton-panel:disabled {
    opacity: 0.45;
  }
  .boton-panel[aria-pressed='true'] {
    background: var(--color-eosina);
    border-color: var(--color-eosina);
    color: #fff;
  }

  .lista-estructuras {
    list-style: none;
    margin: 0;
    padding: 0 0.5rem 0.5rem;
  }

  .fila-estructura {
    display: flex;
    width: 100%;
    align-items: flex-start;
    gap: 0.6rem;
    border-radius: 0.5rem;
    padding: 0.45rem 0.55rem;
    font-size: 0.86rem;
    line-height: 1.35;
    color: var(--atlas-texto);
    transition: background-color 140ms;
  }
  .fila-estructura:hover {
    background: color-mix(in srgb, var(--atlas-acento) 8%, transparent);
  }
  .fila-estructura[aria-current='true'] {
    background: var(--color-eosina-tenue);
    color: var(--color-nucleo);
    box-shadow: inset 2px 0 0 var(--color-eosina);
  }
  :root[data-tema='oscuro'] .fila-estructura[aria-current='true'],
  .fila-estructura[aria-current='true'] {
    /* el contraste se mantiene porque el fondo es claro y el texto núcleo */
  }

  .numero-fila {
    display: grid;
    place-items: center;
    height: 1.3rem;
    min-width: 1.3rem;
    padding-inline: 0.25rem;
    flex: none;
    border-radius: 999px;
    border: 1px solid color-mix(in srgb, var(--atlas-texto-suave) 35%, transparent);
    color: var(--atlas-texto-suave);
    font-size: 0.68rem;
    font-weight: 500;
    font-variant-numeric: tabular-nums;
    translate: 0 0.05rem;
  }
  .fila-estructura[aria-current='true'] .numero-fila {
    border-color: var(--color-eosina);
    background: var(--color-eosina);
    color: #fff;
  }

  .sin-marcador {
    display: inline-block;
    margin-left: 0.35rem;
    border-radius: 3px;
    border: 1px solid var(--atlas-borde);
    padding: 0 0.25rem;
    font-size: 0.62rem;
    color: var(--atlas-texto-suave);
    vertical-align: 1px;
  }

  .nombre-oculto {
    font-style: italic;
    color: var(--atlas-texto-suave);
  }

  kbd {
    display: inline-block;
    border: 1px solid var(--atlas-borde);
    border-radius: 3px;
    padding: 0 0.25rem;
    font-family: var(--font-sans);
    font-size: 0.68rem;
  }
</style>

<script>
  const texto = document.getElementById('descripcion-placa');
  const boton = document.getElementById('alternar-descripcion');
  const etiqueta = boton?.querySelector('span');

  // Si el texto cabe entero, el boton sobra.
  if (texto && boton) {
    const recortado = texto.scrollHeight - texto.clientHeight > 2;
    if (!recortado) boton.hidden = true;

    boton.addEventListener('click', () => {
      const abierta = texto.dataset.abierta === 'si';
      texto.dataset.abierta = abierta ? 'no' : 'si';
      boton.setAttribute('aria-expanded', String(!abierta));
      if (etiqueta) {
        etiqueta.textContent = abierta ? 'Leer la descripción completa' : 'Mostrar menos';
      }
    });
  }
</script>
