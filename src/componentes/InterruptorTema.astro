---
// Interruptor manual de tema. El valor por defecto es prefers-color-scheme;
// al pulsar se fija data-tema en <html> y se recuerda en localStorage.
import Icono from './Icono.astro';
---

<button type="button" id="interruptor-tema" class="interruptor-tema" aria-live="polite">
  <span class="solo-lectores" id="etiqueta-tema">Cambiar a modo oscuro</span>
  <Icono nombre="sun" clase="icono-tema" />
  <span data-icono="oscuro" hidden>
    <Icono nombre="moon" clase="icono-tema" />
  </span>
</button>

<style>
  .interruptor-tema {
    display: grid;
    place-items: center;
    height: 2rem;
    width: 2rem;
    flex: none;
    border-radius: var(--radius-chapa);
    font-size: 1.05rem;
    color: var(--atlas-texto-suave);
    transition:
      color 150ms,
      background-color 150ms;
  }
  .interruptor-tema:hover {
    background: var(--atlas-superficie-alta);
    color: var(--atlas-texto);
  }
  /* Los dos iconos se apilan en la misma celda para que el boton no cambie
     de tamano al alternar. */
  .interruptor-tema > * {
    grid-area: 1 / 1;
  }
</style>

<script>
  const boton = document.getElementById('interruptor-tema');
  const etiqueta = document.getElementById('etiqueta-tema');
  // El icono de sol es el primer hijo dibujado; el de luna va envuelto.
  const iconoClaro = boton?.querySelector('svg');
  const iconoOscuro = boton?.querySelector('[data-icono="oscuro"]');

  function esOscuro(): boolean {
    const fijado = document.documentElement.dataset.tema;
    if (fijado === 'oscuro') return true;
    if (fijado === 'claro') return false;
    return window.matchMedia('(prefers-color-scheme: dark)').matches;
  }

  function sincronizar() {
    const oscuro = esOscuro();
    iconoClaro?.toggleAttribute('hidden', oscuro);
    iconoOscuro?.toggleAttribute('hidden', !oscuro);
    if (etiqueta) etiqueta.textContent = oscuro ? 'Cambiar a modo claro' : 'Cambiar a modo oscuro';
  }

  boton?.addEventListener('click', () => {
    const siguiente = esOscuro() ? 'claro' : 'oscuro';
    document.documentElement.dataset.tema = siguiente;
    try {
      localStorage.setItem('atlas-tema', siguiente);
    } catch {
      /* modo privado: el tema no se recuerda */
    }
    sincronizar();
  });

  window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', sincronizar);
  sincronizar();
</script>
