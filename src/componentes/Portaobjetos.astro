---
import type { Placa } from '../utils/placas';
import { imagenesDe, urlImagen, textoBusqueda } from '../utils/placas';
import { acentoSistema, nombreSistema } from '../datos/sistemas';
import { rutaPlaca } from '../utils/ruta';

interface Props {
  placa: Placa;
  /** Las primeras miniaturas se cargan de inmediato; el resto en diferido. */
  prioridad?: boolean;
}
const { placa, prioridad = false } = Astro.props;
const sistema = nombreSistema(placa.sistema);
const acento = acentoSistema(placa.sistema);
const portada = imagenesDe(placa)[0]!;
const busqueda = textoBusqueda(placa, sistema);
const nEstructuras = placa.estructuras.length;
---

<li class="placa-item" data-placa data-sistema={placa.sistema} data-busqueda={busqueda}>
  <a href={rutaPlaca(placa.id)} class="placa group block no-underline" style={`--acento: ${acento}`}>
    <!-- La lámina manda: sin caja, sin sombra, sin marco. -->
    <div class="placa__lamina">
      <img
        src={urlImagen(portada.archivo, 'miniatura')}
        alt={`Preparación: ${placa.titulo}`}
        width="480"
        height="360"
        loading={prioridad ? 'eager' : 'lazy'}
        decoding="async"
      />
      {placa.aumentos.length > 0 && (
        <span class="placa__aumento tabular-nums">{placa.aumentos.join(' · ')}</span>
      )}
      {placa.borrador && <span class="placa__revisar">Revisar</span>}
    </div>

    <h3 class="placa__titulo">{placa.titulo}</h3>
    <p class="placa__meta">
      <span class="placa__punto" aria-hidden="true" />
      <span class="truncate">{placa.organo || sistema}</span>
      <span class="placa__sep" aria-hidden="true">·</span>
      <span class="shrink-0 tabular-nums">{nEstructuras}</span>
    </p>
  </a>
</li>

<style>
  .placa__lamina {
    position: relative;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-radius: 0.5rem;
    background: var(--color-nucleo);
    /* Un filo finísimo en vez de una sombra: separa sin pesar. */
    box-shadow: inset 0 0 0 1px rgb(26 18 51 / 0.1);
  }

  .placa__lamina img {
    display: block;
    height: 100%;
    width: 100%;
    object-fit: cover;
    transition: transform 500ms var(--ease-visor);
  }

  .placa:hover .placa__lamina img,
  .placa:focus-visible .placa__lamina img {
    transform: scale(1.04);
  }

  /* Chapitas sobre la lámina: discretas, sólo cuando hacen falta. */
  .placa__aumento,
  .placa__revisar {
    position: absolute;
    bottom: 0.5rem;
    border-radius: 0.25rem;
    padding: 0.1rem 0.35rem;
    font-size: 0.65rem;
    line-height: 1.4;
    letter-spacing: 0.01em;
    backdrop-filter: blur(6px);
  }
  .placa__aumento {
    right: 0.5rem;
    background: rgb(14 9 32 / 0.55);
    color: rgb(255 255 255 / 0.92);
  }
  .placa__revisar {
    left: 0.5rem;
    background: color-mix(in srgb, var(--color-eosina) 88%, transparent);
    color: #fff;
    font-weight: 500;
  }

  .placa__titulo {
    margin-top: 0.7rem;
    font-family: var(--font-serif);
    font-size: 1.05rem;
    font-weight: 450;
    line-height: 1.25;
    letter-spacing: -0.008em;
    color: var(--atlas-texto);
    transition: color 160ms;
  }
  .placa:hover .placa__titulo {
    color: var(--color-eosina);
  }

  .placa__meta {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    margin-top: 0.2rem;
    font-size: 0.76rem;
    color: var(--atlas-texto-suave);
  }
  .placa__punto {
    height: 0.3rem;
    width: 0.3rem;
    flex: none;
    border-radius: 999px;
    background: var(--acento);
  }
  .placa__sep {
    opacity: 0.4;
  }

  .placa-item[hidden] {
    display: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .placa:hover .placa__lamina img,
    .placa:focus-visible .placa__lamina img {
      transform: none;
    }
  }
</style>
