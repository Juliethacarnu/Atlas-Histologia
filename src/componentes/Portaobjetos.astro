---
import type { Placa } from '../utils/placas';
import { imagenesDe, urlImagen, textoBusqueda } from '../utils/placas';
import { acentoSistema, nombreSistema } from '../datos/sistemas';
import { rutaPlaca } from '../utils/ruta';
import { proporcionDe } from '../utils/dimensiones';

interface Props {
  placa: Placa;
  /** Las primeras miniaturas se cargan de inmediato; el resto en diferido. */
  prioridad?: boolean;
  /** Otra placa del mismo sistema se llama igual: hay que distinguirlas. */
  tituloRepetido?: boolean;
}
const { placa, prioridad = false, tituloRepetido = false } = Astro.props;
const sistema = nombreSistema(placa.sistema);
const acento = acentoSistema(placa.sistema);
const portada = imagenesDe(placa)[0]!;
const busqueda = textoBusqueda(placa, sistema);
const nEstructuras = placa.estructuras.length;
const aumentos = placa.aumentos.join(' · ');
// La bandeja respeta la forma de cada preparación en vez de recortarlas todas
// al mismo rectángulo: una tráquea es panorámica y un duodeno es redondo.
const proporcion = await proporcionDe(portada.archivo);

// Si el organo repite el titulo no aporta nada; en su lugar se dice el sistema.
const segundaLinea =
  placa.organo && placa.organo.toLowerCase() !== placa.titulo.toLowerCase()
    ? placa.organo
    : sistema;
---

<li
  class="placa-item"
  data-placa
  data-sistema={placa.sistema}
  data-busqueda={busqueda}
  data-titulo={placa.titulo}
  data-donde={segundaLinea}
>
  <a href={rutaPlaca(placa.id)} class="placa group block no-underline" style={`--acento: ${acento}`}>
    <!-- La lámina manda: sin caja, sin sombra, sin marco. -->
    <div class="placa__lamina" style={`--proporcion: ${proporcion.toFixed(4)}`}>
      <img
        src={urlImagen(portada.archivo, 'miniatura')}
        data-lupa={urlImagen(portada.archivo, 'media')}
        alt={`Preparación: ${placa.titulo}`}
        width="480"
        height={Math.round(480 / proporcion)}
        loading={prioridad ? 'eager' : 'lazy'}
        decoding="async"
      />
      {aumentos && !tituloRepetido && (
        <span class="placa__aumento tabular-nums">{aumentos}</span>
      )}
      {placa.borrador && <span class="placa__revisar">Revisar</span>}
    </div>

    <h3 class="placa__titulo">
      {placa.titulo}
      {tituloRepetido && aumentos && (
        <span class="placa__titulo-aumento tabular-nums">{aumentos}</span>
      )}
    </h3>
    <p class="placa__meta">
      <span class="placa__punto" aria-hidden="true" />
      <span class="truncate">{segundaLinea}</span>
      {nEstructuras > 0 && (
        <>
          <span class="placa__sep" aria-hidden="true">·</span>
          <span class="shrink-0 tabular-nums">{nEstructuras}</span>
        </>
      )}
    </p>
  </a>
</li>

<style>
  .placa__lamina {
    position: relative;
    aspect-ratio: var(--proporcion, 4 / 3);
    overflow: hidden;
    /* Angulos rectos: una lámina montada, no una tarjeta de aplicación. */
    border-radius: 0;
    background: var(--color-nucleo);
    /* Un filo finísimo en vez de una sombra: separa sin pesar. */
    box-shadow: inset 0 0 0 1px rgb(28 26 22 / 0.14);
    transition: box-shadow 200ms;
  }
  /* Al pasar por encima se enciende el filo con el color de su sistema:
     el mismo color que la cinta que la sujeta. */
  .placa:hover .placa__lamina,
  .placa:focus-visible .placa__lamina {
    box-shadow:
      0 0 0 1px color-mix(in srgb, var(--acento) 60%, transparent),
      0 0 0 5px color-mix(in srgb, var(--acento) 22%, transparent),
      var(--sombra-flote-alta);
  }

  .placa__lamina img {
    display: block;
    height: 100%;
    width: 100%;
    object-fit: cover;
    transition: transform 600ms var(--ease-visor);
  }

  /* Un acercamiento muy leve: insinúa el zoom del visor sin recortar. */
  .placa:hover .placa__lamina img,
  .placa:focus-visible .placa__lamina img {
    transform: scale(1.035);
  }

  /* Chapitas sobre la lámina: discretas, sólo cuando hacen falta. */
  .placa__aumento,
  .placa__revisar {
    position: absolute;
    bottom: 0.4rem;
    border-radius: 2px;
    padding: 0.08rem 0.35rem;
    font-size: 0.65rem;
    line-height: 1.45;
    backdrop-filter: blur(6px);
  }
  .placa__aumento {
    right: 0.4rem;
    background: rgb(14 9 32 / 0.66);
    color: rgb(255 255 255 / 0.94);
  }
  .placa__revisar {
    left: 0.45rem;
    background: color-mix(in srgb, var(--color-eosina) 88%, transparent);
    color: var(--atlas-sobre-eosina);
    font-weight: 500;
  }

  /* El pie de la lámina va bajo un filete, como el de una reproducción
     impresa: primero el filete, luego el título, luego la referencia. */
  .placa__titulo {
    display: flex;
    align-items: baseline;
    gap: 0.4rem;
    margin-top: 0.55rem;
    padding-top: 0.45rem;
    border-top: 1px solid var(--atlas-borde-fuerte);
    font-family: var(--font-serif);
    font-size: 1.1rem;
    font-weight: 400;
    line-height: 1.22;
    letter-spacing: -0.01em;
    color: var(--atlas-texto);
    transition: color 160ms;
  }
  .placa:hover .placa__titulo {
    color: var(--color-eosina);
  }

  /* Cuando dos láminas se llaman igual, el aumento entra en el título. */
  .placa__titulo-aumento {
    flex: none;
    font-family: var(--font-sans);
    font-size: 0.72rem;
    font-weight: 500;
    color: var(--atlas-texto-suave);
  }

  .placa__meta {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    margin-top: 0.2rem;
    font-size: 0.73rem;
    color: var(--atlas-texto-suave);
  }
  .placa__punto {
    height: 0.3rem;
    width: 0.3rem;
    flex: none;
    border-radius: 999px;
    background: var(--acento);
  }
  .placa__sep {
    opacity: 0.4;
  }

  .placa-item {
    break-inside: avoid;
    /* Evita que una tarjeta quede cortada al final de una columna. */
    page-break-inside: avoid;
  }
  .placa-item[hidden] {
    display: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .placa:hover .placa__lamina img,
    .placa:focus-visible .placa__lamina img {
      transform: none;
    }
  }
</style>
