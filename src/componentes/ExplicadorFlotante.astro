---
import type { Placa, Presentador } from '../utils/placas';
import Avatar from './Avatar.astro';
import Icono from './Icono.astro';

interface Props {
  placa: Placa;
  presentador: Presentador | null;
}
const { placa, presentador } = Astro.props;
const video = placa.video;
const esAudio = video?.tipo === 'audio';
const nombre = presentador?.nombre ?? 'Sin presentador';
const rol = presentador?.rol ?? '';

const porNumero = new Map(placa.estructuras.map((e) => [e.id, e]));
const capitulos = (video?.capitulos ?? [])
  .map((c) => ({ ...c, estructura: porNumero.get(c.estructuraId) }))
  .filter((c) => c.estructura)
  .sort((a, b) => a.tiempoSegundos - b.tiempoSegundos);

function reloj(s: number) {
  const m = Math.floor(s / 60);
  const r = Math.floor(s % 60);
  return `${m}:${String(r).padStart(2, '0')}`;
}

const subtitulo = video ? 'explica esta lámina' : 'sin explicación todavía';
---

<div
  id="explicador"
  class="explicador"
  data-tiene-video={video ? 'si' : 'no'}
  aria-labelledby="explicador-nombre"
>
  <!-- Burbuja: estado minimizado -->
  <button type="button" id="explicador-abrir" class="explicador__burbuja" aria-expanded="false">
    <Avatar presentador={presentador} tamano={48} animable={!!video} clase="avatar-burbuja" />
    <span class="solo-lectores">Abrir al explicador: {nombre}</span>
    {video && <span class="explicador__punto" aria-hidden="true" />}
  </button>

  <!-- Ventana -->
  <section class="explicador__ventana panel-flotante" aria-label="Explicación de la lámina">
    <header class="explicador__cabecera">
      {!esAudio && (
        <Avatar presentador={presentador} tamano={34} animable={!!video} clase="avatar-cabecera" />
      )}
      <div class="min-w-0 flex-1">
        <p id="explicador-nombre" class="explicador__nombre">{nombre}</p>
        <p class="explicador__rol">{rol ? `${rol} · ${subtitulo}` : subtitulo}</p>
      </div>
      <button type="button" id="explicador-minimizar" class="explicador__icono" aria-keyshortcuts="M">
        <span class="solo-lectores">Minimizar al explicador</span>
        <Icono nombre="minus" />
      </button>
    </header>

    {video ? (
      <>
        {esAudio ? (
          <>
            {/* Solo voz: la caricatura es la imagen del reproductor. */}
            <div class="explicador__escenario">
              <Avatar
                presentador={presentador}
                tamano={116}
                animable={true}
                conBucle={true}
                clase="avatar-escenario"
              />
            </div>
            {/* El transporte propio se monta aquí desde el cliente. */}
            <div id="hueco-video" class="explicador__transporte-hueco" />
          </>
        ) : (
          <>
            <div id="hueco-video" class="aspect-video w-full overflow-hidden bg-black" />
            <div class="flex items-center gap-2 px-3 py-2">
              <button type="button" id="video-alternar" class="explicador__play">
                <span data-icono="play"><Icono nombre="play" peso="fill" /></span>
                <span data-icono="pausa" hidden><Icono nombre="pause" peso="fill" /></span>
                <span class="solo-lectores" id="video-alternar-texto">Reproducir el video</span>
              </button>
              <p class="text-[0.72rem] tabular-nums text-texto-suave">
                <span id="video-tiempo">0:00</span>
              </p>
            </div>
          </>
        )}

        {capitulos.length > 0 && (
          <>
            <p class="explicador__capitulo-actual">
              <span id="video-capitulo-actual">
                {capitulos.length === 1 ? '1 capítulo' : `${capitulos.length} capítulos`}
              </span>
            </p>
            <details class="explicador__capitulos">
              <summary>Capítulos</summary>
              <ol role="list">
                {capitulos.map((c) => (
                  <li>
                    <button type="button" data-capitulo={c.estructuraId} data-tiempo={c.tiempoSegundos}>
                      <span class="tabular-nums opacity-65">{reloj(c.tiempoSegundos)}</span>
                      <span class="truncate" data-nombre-capitulo>{c.estructura!.nombre}</span>
                    </button>
                  </li>
                ))}
              </ol>
            </details>
          </>
        )}

        {/* Un <audio> no muestra subtítulos: el .vtt se pinta como transcripción. */}
        {esAudio && video.subtitulos && (
          <details class="explicador__capitulos transcripcion" id="transcripcion" hidden>
            <summary>Transcripción</summary>
            <ol role="list" id="transcripcion-lista" />
          </details>
        )}
      </>
    ) : (
      <div class="px-3.5 pb-3.5">
        <p class="explicador__resumen">
          {placa.descripcionGeneral ||
            'Todavía no hay explicación para esta lámina. Cuando subas el audio, aparecerá aquí junto a la caricatura del presentador.'}
        </p>
      </div>
    )}
  </section>
</div>

<style>
  .explicador {
    position: fixed;
    right: 0.75rem;
    bottom: 0.75rem;
    z-index: 40;
  }
  @media (min-width: 1024px) {
    .explicador {
      /* Dentro del marco del visor, a la izquierda del panel de estructuras. */
      position: absolute;
      right: 23.75rem;
      bottom: 0.875rem;
    }
  }

  .explicador__ventana {
    width: min(17.5rem, calc(100vw - 1.5rem));
    overflow: hidden;
  }

  /* --- Cabecera --- */
  .explicador__cabecera {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.6rem 0.65rem 0.55rem 0.85rem;
  }
  .explicador__nombre {
    font-family: var(--font-serif);
    font-size: 0.95rem;
    font-weight: 500;
    line-height: 1.2;
    letter-spacing: -0.01em;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .explicador__rol {
    font-size: 0.7rem;
    line-height: 1.35;
    color: var(--atlas-texto-suave);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  /* Escenario del modo audio: la caricatura sobre el campo oscuro, el mismo
     material que el fondo del visor. */
  .explicador__escenario {
    display: grid;
    place-items: end center;
    aspect-ratio: 16 / 11;
    background: var(--color-nucleo);
  }

  .explicador__transporte-hueco {
    padding: 0.6rem 0.85rem 0.75rem;
  }

  .explicador__burbuja {
    display: none;
    position: relative;
    border-radius: 999px;
    background: color-mix(in srgb, var(--atlas-superficie) 92%, transparent);
    backdrop-filter: blur(10px);
    border: 1px solid color-mix(in srgb, var(--atlas-borde) 70%, transparent);
    box-shadow: var(--atlas-sombra-alta);
    padding: 0.2rem;
  }

  /* Estado minimizado */
  .explicador--minimizado .explicador__ventana {
    display: none;
  }
  .explicador--minimizado .explicador__burbuja {
    display: block;
  }

  .explicador__punto {
    position: absolute;
    right: 0.1rem;
    bottom: 0.1rem;
    height: 0.6rem;
    width: 0.6rem;
    border-radius: 999px;
    border: 2px solid var(--atlas-superficie);
    background: var(--color-eosina);
  }

  .explicador__icono {
    display: grid;
    place-items: center;
    height: 1.6rem;
    width: 1.6rem;
    flex: none;
    border-radius: var(--radius-chapa);
    font-size: 1rem;
    color: var(--atlas-texto-suave);
  }
  .explicador__icono:hover {
    background: var(--atlas-fondo);
    color: var(--atlas-texto);
  }

  .explicador__play {
    display: grid;
    place-items: center;
    height: 2rem;
    width: 2rem;
    flex: none;
    border-radius: 999px;
    background: var(--color-eosina);
    font-size: 1.05rem;
    color: #fff;
  }

  /* Sin video, la tarjeta mostraba la descripcion entera y tapaba media
     lamina. Se recorta: el texto completo ya esta en el panel lateral. */
  .explicador__resumen {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 4;
    line-clamp: 4;
    overflow: hidden;
    font-size: 0.8rem;
    line-height: 1.55;
    color: var(--atlas-texto-suave);
  }

  .explicador__capitulo-actual {
    padding: 0 0.85rem 0.5rem;
    font-size: 0.7rem;
    color: var(--atlas-texto-suave);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .explicador__capitulos {
    border-top: 1px solid var(--atlas-borde);
    font-size: 0.76rem;
  }
  .explicador__capitulos summary {
    cursor: pointer;
    padding: 0.4rem 0.85rem;
    color: var(--atlas-texto-suave);
  }
  .explicador__capitulos ol {
    list-style: none;
    margin: 0;
    padding: 0 0.5rem 0.5rem;
    max-height: 9rem;
    overflow-y: auto;
  }
  .explicador__capitulos button {
    display: flex;
    width: 100%;
    gap: 0.5rem;
    border-radius: 0.35rem;
    padding: 0.25rem 0.4rem;
    text-align: left;
    color: var(--atlas-texto);
  }
  .explicador__capitulos button:hover {
    background: var(--atlas-fondo);
  }
  .explicador__capitulos button[aria-current='true'] {
    background: var(--color-eosina-tenue);
    color: var(--color-tinta);
  }

  /* Transcripción del audio */
  .transcripcion ol {
    max-height: 11rem;
  }
  :global(.transcripcion__linea) {
    align-items: baseline;
  }
  :global(.transcripcion__marca) {
    flex: none;
    font-variant-numeric: tabular-nums;
    opacity: 0.6;
  }
</style>

<!-- El transporte del audio se construye desde el cliente: sus estilos tienen
     que ser globales para alcanzarlo. -->
<style is:global>
  .transporte {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .transporte__play {
    display: grid;
    place-items: center;
    height: 2.1rem;
    width: 2.1rem;
    flex: none;
    border-radius: 999px;
    background: var(--color-eosina);
    color: #fff;
    transition: background-color 150ms;
  }
  .transporte__play:hover {
    background: var(--color-eosina-claro);
  }
  .transporte__play .icono {
    width: 1.05rem;
    height: 1.05rem;
  }

  /* La línea de avance: un riel de pelo que se tiñe de eosina al pasar. */
  .transporte__barra {
    --avance: 0%;
    flex: 1;
    min-width: 0;
    height: 1rem;
    appearance: none;
    background: transparent;
    cursor: pointer;
  }
  .transporte__barra::-webkit-slider-runnable-track {
    height: 3px;
    border-radius: 999px;
    background: linear-gradient(
      to right,
      var(--color-eosina) var(--avance),
      var(--atlas-borde-fuerte) var(--avance)
    );
  }
  .transporte__barra::-moz-range-track {
    height: 3px;
    border-radius: 999px;
    background: linear-gradient(
      to right,
      var(--color-eosina) var(--avance),
      var(--atlas-borde-fuerte) var(--avance)
    );
  }
  .transporte__barra::-webkit-slider-thumb {
    appearance: none;
    height: 0.7rem;
    width: 0.7rem;
    margin-top: -0.2rem;
    border-radius: 999px;
    background: var(--color-eosina);
    box-shadow: 0 0 0 2px var(--atlas-superficie);
  }
  .transporte__barra::-moz-range-thumb {
    height: 0.7rem;
    width: 0.7rem;
    border: 0;
    border-radius: 999px;
    background: var(--color-eosina);
    box-shadow: 0 0 0 2px var(--atlas-superficie);
  }

  /* Las líneas de la transcripción también nacen en el cliente. */
  #transcripcion-lista button {
    display: flex;
    width: 100%;
    gap: 0.5rem;
    border-radius: 0.35rem;
    padding: 0.25rem 0.4rem;
    text-align: left;
    font-size: 0.76rem;
    line-height: 1.45;
    color: var(--atlas-texto);
  }
  #transcripcion-lista button:hover {
    background: var(--atlas-fondo);
  }
  #transcripcion-lista button[aria-current='true'] {
    background: var(--color-eosina-tenue);
    color: var(--color-nucleo);
  }

  .transporte__tiempo {
    flex: none;
    font-size: 0.68rem;
    line-height: 1.2;
    color: var(--atlas-texto-suave);
  }
</style>
