---
import type { ImagenPlaca } from '../utils/placas';
import { urlImagen } from '../utils/placas';
import Icono from './Icono.astro';

interface Props {
  imagenes: ImagenPlaca[];
  titulo: string;
}
const { imagenes, titulo } = Astro.props;
const variasImagenes = imagenes.length > 1;
---

<div id="marco-visor" class="vineta-campo relative isolate h-full w-full overflow-hidden bg-campo">
  <!-- Contenedor de OpenSeadragon -->
  <div
    id="visor"
    class="absolute inset-0"
    aria-label={`Visor de la preparación: ${titulo}`}
    role="application"
  >
  </div>

  <!-- Mensaje mientras carga / si falla la imagen -->
  <p
    id="estado-visor"
    class="pointer-events-none absolute inset-0 grid place-items-center text-sm text-white/55"
  >
    Cargando la preparación…
  </p>

  {
    variasImagenes && (
      <div class="tira" role="group" aria-label="Imágenes de esta preparación">
        {imagenes.map((im, i) => (
          <button type="button" class="tira__hoja" data-imagen={i} aria-pressed={i === 0}>
            <img src={urlImagen(im.archivo, 'miniatura')} alt="" aria-hidden="true" loading="lazy" />
            <span class="tira__etiqueta">{im.aumento || `Imagen ${i + 1}`}</span>
            <span class="solo-lectores">
              Ver {im.aumento ? `el aumento ${im.aumento}` : `la imagen ${i + 1}`} de {titulo}
            </span>
          </button>
        ))}
      </div>
    )
  }

  <!-- Minimapa -->
  <div
    id="minimapa"
    class="chapa-campo absolute top-3 right-3 z-20 h-24 w-32 overflow-hidden max-sm:hidden! lg:right-[23.75rem]"
    aria-hidden="true"
  >
  </div>

  <!-- Controles de tamaño -->
  <div class="chapa-campo absolute bottom-3 left-3 z-20 flex items-center gap-0.5 p-1">
    <button type="button" class="boton-visor" data-accion="acercar" aria-keyshortcuts="+">
      <span class="solo-lectores">Acercar</span>
      <Icono nombre="magnifying-glass-plus" />
    </button>
    <button type="button" class="boton-visor" data-accion="alejar" aria-keyshortcuts="-">
      <span class="solo-lectores">Alejar</span>
      <Icono nombre="magnifying-glass-minus" />
    </button>
    <button type="button" class="boton-visor" data-accion="ajustar" aria-keyshortcuts="0">
      <span class="solo-lectores">Ajustar a la pantalla</span>
      <Icono nombre="corners-in" />
    </button>
    <button type="button" class="boton-visor" data-accion="pantalla-completa">
      <span class="solo-lectores">Pantalla completa</span>
      <Icono nombre="corners-out" />
    </button>
  </div>

  <!-- Crédito de la imagen visible -->
  <p
    id="credito-imagen"
    class="pointer-events-none absolute right-4 bottom-3.5 z-10 max-w-[min(26rem,40%)] truncate text-right text-[0.68rem] text-white/55 max-lg:hidden lg:right-[24.5rem]"
  >
  </p>
</div>

<style is:global>
  /* ---------- La tira de imágenes ----------
     Una placa puede traer dos o tres fotos del mismo corte a distinto aumento.
     Antes se elegían con botones de texto y no se sabía qué había detrás de
     cada uno: ahora se ve la foto, como las hojas de un portaobjetos. */
  .tira {
    position: absolute;
    top: 0.75rem;
    left: 0.75rem;
    z-index: 20;
    display: flex;
    gap: 0.4rem;
  }
  @media (min-width: 1024px) {
    .tira {
      flex-direction: column;
    }
    .tira__hoja {
      width: 4.25rem;
    }
    .tira__hoja img {
      height: 2.75rem;
    }
  }

  .tira__hoja {
    position: relative;
    display: block;
    /* En movil el visor mide poco: la tira se encoge para no comerse la
       lamina, y en escritorio se ve del tamano que merece. */
    width: 3.25rem;
    overflow: hidden;
    border-radius: var(--radius-chapa);
    border: 1px solid rgb(255 255 255 / 0.22);
    background: rgb(14 9 32 / 0.72);
    box-shadow: 0 6px 18px -10px rgb(0 0 0 / 0.8);
    transition:
      border-color 150ms,
      transform 150ms;
  }
  .tira__hoja img {
    display: block;
    width: 100%;
    height: 2.1rem;
    object-fit: cover;
    opacity: 0.72;
    transition: opacity 150ms;
  }
  .tira__hoja:hover {
    border-color: rgb(255 255 255 / 0.55);
  }
  .tira__hoja:hover img {
    opacity: 1;
  }
  .tira__hoja[aria-pressed='true'] {
    border-color: var(--color-eosina);
  }
  .tira__hoja[aria-pressed='true'] img {
    opacity: 1;
  }

  .tira__etiqueta {
    display: block;
    padding: 0.1rem 0.25rem 0.15rem;
    font-size: 0.62rem;
    line-height: 1.3;
    font-variant-numeric: tabular-nums;
    text-align: center;
    color: rgb(255 255 255 / 0.78);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .tira__hoja[aria-pressed='true'] .tira__etiqueta {
    background: var(--color-eosina);
    color: #fff;
  }

  /* ---------- Marcadores numerados ---------- */
  /* El marcador es un ANILLO, no un disco: si fuera macizo taparia justo la
     estructura que senala. El centro queda hueco y el numero va en una
     chapita al lado, fuera del area de interes. */
  .marcador {
    position: relative;
    display: block;
    width: 1.3rem;
    height: 1.3rem;
    border-radius: 999px;
    background: transparent;
    border: 2px solid #fff;
    /* Doble filo oscuro: se distingue tanto sobre tejido claro como oscuro. */
    box-shadow:
      0 0 0 1px rgb(14 9 32 / 0.6),
      inset 0 0 0 1px rgb(14 9 32 / 0.35);
    cursor: pointer;
    transition:
      transform 160ms var(--ease-visor),
      border-color 160ms;
  }

  /* Area de pulsacion mayor que el anillo, invisible: el anillo es pequeno
     pero sigue siendo comodo de tocar en movil. */
  .marcador::before {
    content: '';
    position: absolute;
    inset: -0.55rem;
    border-radius: 999px;
  }

  /* La chapita con el numero, arriba a la derecha del anillo. */
  .marcador > span {
    position: absolute;
    bottom: calc(100% - 0.3rem);
    left: calc(100% - 0.3rem);
    display: block;
    min-width: 1rem;
    padding-inline: 0.2rem;
    border-radius: 999px;
    background: var(--color-hematoxilina);
    color: #fff;
    font-family: var(--font-sans);
    font-size: 0.63rem;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    line-height: 1rem;
    text-align: center;
    box-shadow:
      0 0 0 1.5px #fff,
      0 1px 3px rgb(14 9 32 / 0.5);
  }

  .marcador:hover {
    transform: scale(1.15);
  }

  .marcador--activo {
    border-color: var(--color-eosina);
  }
  .marcador--activo > span {
    background: var(--color-eosina);
  }
  /* El pulso va en una capa aparte para no pisar los filos del anillo. */
  .marcador--activo::after {
    content: '';
    position: absolute;
    inset: -2px;
    border-radius: 999px;
    animation: atlas-pulso-eosina 1.6s ease-out infinite;
  }

  @media (prefers-reduced-motion: reduce) {
    .marcador--activo::after {
      animation: none;
    }
    .marcador--activo {
      border-width: 3px;
    }
  }

  /* En modo repaso el número sigue visible; lo que se oculta es el nombre. */
  .repaso-activo .marcador > span {
    background: var(--color-nucleo);
  }
  .repaso-activo .marcador--activo > span {
    background: var(--color-eosina);
  }

  /* ---------- Botones sobre el campo oscuro ---------- */
  .boton-visor {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border-radius: var(--radius-chapa);
    font-size: 1.15rem;
    color: rgb(255 255 255 / 0.8);
    transition:
      background-color 140ms,
      color 140ms;
  }
  .boton-visor:hover {
    background: rgb(255 255 255 / 0.14);
    color: #fff;
  }

  /* El minimapa de OpenSeadragon */
  #minimapa .displayregion {
    border: 2px solid var(--color-eosina) !important;
  }
</style>
