---
import type { ImagenPlaca } from '../utils/placas';

interface Props {
  imagenes: ImagenPlaca[];
  titulo: string;
}
const { imagenes, titulo } = Astro.props;
const variasImagenes = imagenes.length > 1;
---

<div id="marco-visor" class="vineta-campo relative isolate h-full w-full overflow-hidden bg-campo">
  <!-- Contenedor de OpenSeadragon -->
  <div
    id="visor"
    class="absolute inset-0"
    aria-label={`Visor de la preparación: ${titulo}`}
    role="application"
  ></div>

  <!-- Mensaje mientras carga / si falla la imagen -->
  <p
    id="estado-visor"
    class="pointer-events-none absolute inset-0 grid place-items-center text-sm text-white/55"
  >
    Cargando la preparación…
  </p>

  <!-- Minimapa -->
  <div
    id="minimapa"
    class="absolute top-3 right-3 z-20 h-24 w-32 overflow-hidden rounded-md border border-white/25 bg-nucleo/70 shadow-lg max-sm:hidden! lg:right-[23.5rem]"
    aria-hidden="true"
  ></div>

  <!-- Selector de aumento -->
  {variasImagenes && (
    <div
      class="absolute top-3 left-3 z-20 flex gap-1 rounded-lg border border-white/15 bg-nucleo/75 p-1 backdrop-blur"
      role="group"
      aria-label="Aumento de la preparación"
    >
      {imagenes.map((im, i) => (
        <button
          type="button"
          data-imagen={i}
          aria-pressed={i === 0 ? 'true' : 'false'}
          class="boton-aumento"
        >
          {im.aumento || `Imagen ${i + 1}`}
        </button>
      ))}
    </div>
  )}

  <!-- Controles de zoom -->
  <div
    class="absolute bottom-3 left-3 z-20 flex gap-1 rounded-lg border border-white/15 bg-nucleo/75 p-1 backdrop-blur"
    role="group"
    aria-label="Controles del visor"
  >
    <button type="button" class="boton-visor" data-accion="acercar" aria-keyshortcuts="+">
      <span class="solo-lectores">Acercar</span>
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="M12 6v12M6 12h12" />
      </svg>
    </button>
    <button type="button" class="boton-visor" data-accion="alejar" aria-keyshortcuts="-">
      <span class="solo-lectores">Alejar</span>
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="M6 12h12" />
      </svg>
    </button>
    <button type="button" class="boton-visor" data-accion="ajustar" aria-keyshortcuts="0">
      <span class="solo-lectores">Ajustar a la pantalla</span>
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="M4 9V5.5A1.5 1.5 0 0 1 5.5 4H9M15 4h3.5A1.5 1.5 0 0 1 20 5.5V9M20 15v3.5a1.5 1.5 0 0 1-1.5 1.5H15M9 20H5.5A1.5 1.5 0 0 1 4 18.5V15" />
      </svg>
    </button>
    <button type="button" class="boton-visor" data-accion="pantalla-completa">
      <span class="solo-lectores">Pantalla completa</span>
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="M4 8V4h4M16 4h4v4M20 16v4h-4M8 20H4v-4" />
      </svg>
    </button>
  </div>

  <!-- Crédito de la imagen visible -->
  <p
    id="credito-imagen"
    class="absolute bottom-3 left-1/2 z-10 -translate-x-1/2 px-3 text-center text-[0.7rem] text-white/45 max-sm:hidden"
  ></p>
</div>

<style is:global>
  /* ---------- Marcadores numerados ---------- */
  /* El marcador es un ANILLO, no un disco: si fuera macizo taparia justo la
     estructura que senala. El centro queda hueco y el numero va en una
     chapita al lado, fuera del area de interes. */
  .marcador {
    position: relative;
    display: block;
    width: 1.3rem;
    height: 1.3rem;
    border-radius: 999px;
    background: transparent;
    border: 2px solid #fff;
    /* Doble filo oscuro: se distingue tanto sobre tejido claro como oscuro. */
    box-shadow:
      0 0 0 1px rgb(14 9 32 / 0.6),
      inset 0 0 0 1px rgb(14 9 32 / 0.35);
    cursor: pointer;
    transition:
      transform 160ms var(--ease-visor),
      border-color 160ms;
  }

  /* Area de pulsacion mayor que el anillo, invisible: el anillo es pequeno
     pero sigue siendo comodo de tocar en movil. */
  .marcador::before {
    content: '';
    position: absolute;
    inset: -0.55rem;
    border-radius: 999px;
  }

  /* La chapita con el numero, arriba a la derecha del anillo. */
  .marcador > span {
    position: absolute;
    bottom: calc(100% - 0.3rem);
    left: calc(100% - 0.3rem);
    display: block;
    min-width: 1rem;
    padding-inline: 0.2rem;
    border-radius: 999px;
    background: var(--color-hematoxilina);
    color: #fff;
    font-family: var(--font-sans);
    font-size: 0.63rem;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    line-height: 1rem;
    text-align: center;
    box-shadow:
      0 0 0 1.5px #fff,
      0 1px 3px rgb(14 9 32 / 0.5);
  }

  .marcador:hover {
    transform: scale(1.15);
  }

  .marcador--activo {
    border-color: var(--color-eosina);
  }
  .marcador--activo > span {
    background: var(--color-eosina);
  }
  /* El pulso va en una capa aparte para no pisar los filos del anillo. */
  .marcador--activo::after {
    content: '';
    position: absolute;
    inset: -2px;
    border-radius: 999px;
    animation: atlas-pulso-eosina 1.6s ease-out infinite;
  }

  @media (prefers-reduced-motion: reduce) {
    .marcador--activo::after {
      animation: none;
    }
    .marcador--activo {
      border-width: 3px;
    }
  }

  /* En modo repaso el número sigue visible; lo que se oculta es el nombre. */
  .repaso-activo .marcador > span {
    background: var(--color-nucleo);
  }
  .repaso-activo .marcador--activo > span {
    background: var(--color-eosina);
  }

  /* ---------- Botones sobre el campo oscuro ---------- */
  .boton-visor,
  .boton-aumento {
    display: grid;
    place-items: center;
    border-radius: 0.375rem;
    color: rgb(255 255 255 / 0.8);
    transition:
      background-color 140ms,
      color 140ms;
  }
  .boton-visor {
    width: 2rem;
    height: 2rem;
  }
  .boton-visor svg {
    width: 1.05rem;
    height: 1.05rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .boton-aumento {
    padding: 0.25rem 0.6rem;
    font-size: 0.78rem;
    font-variant-numeric: tabular-nums;
  }
  .boton-visor:hover,
  .boton-aumento:hover {
    background: rgb(255 255 255 / 0.14);
    color: #fff;
  }
  .boton-aumento[aria-pressed='true'] {
    background: var(--color-eosina);
    color: #fff;
  }

  /* El minimapa de OpenSeadragon */
  #minimapa .displayregion {
    border: 2px solid var(--color-eosina) !important;
  }
</style>
