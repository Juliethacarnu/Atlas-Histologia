---
import type { ImagenPlaca } from '../utils/placas';
import { urlImagen } from '../utils/placas';
import Icono from './Icono.astro';

interface Props {
  imagenes: ImagenPlaca[];
  titulo: string;
}
const { imagenes, titulo } = Astro.props;
const variasImagenes = imagenes.length > 1;
---

<div id="marco-visor" class="vineta-campo relative isolate h-full w-full overflow-hidden bg-campo">
  <!-- Contenedor de OpenSeadragon -->
  <div
    id="visor"
    class="absolute inset-0"
    aria-label={`Visor de la preparación: ${titulo}`}
    role="application"
  >
  </div>

  {/* Mientras llega la lámina grande se enseña la miniatura desenfocada: se
      ve de qué va la preparación en vez de un rectángulo vacío. */}
  <div id="estado-visor" class="cargando" role="status">
    <img
      class="cargando__previa"
      src={urlImagen(imagenes[0]!.archivo, 'miniatura')}
      alt=""
      aria-hidden="true"
    />
    <span class="cargando__barra" aria-hidden="true"></span>
    <span class="solo-lectores">Cargando la preparación: {titulo}</span>
  </div>

  {/* Si la imagen no llega, la lámina sigue sirviendo: debajo queda su lista
      de estructuras y su ficha. */}
  <div id="fallo-visor" class="fallo" role="alert" hidden>
    <p class="fallo__texto">No se pudo cargar la imagen de esta preparación.</p>
    <button type="button" id="fallo-reintentar" class="fallo__boton">Reintentar</button>
  </div>

  {
    variasImagenes && (
      <div
        class="tira"
        id="tira-imagenes"
        role="group"
        aria-label="Imágenes de esta preparación"
        data-abierta="no"
      >
        {/* Cabecera que solo se ve cuando la tira es una hoja, en movil. */}
        <div class="tira__cabecera">
          <p class="tira__titulo">Imágenes de esta lámina</p>
          <button type="button" id="cerrar-laminas" class="tira__cerrar">
            <span class="solo-lectores">Cerrar las imágenes</span>
            <Icono nombre="x" />
          </button>
        </div>
        {imagenes.map((im, i) => (
          <button type="button" class="tira__hoja" data-imagen={i} aria-pressed={i === 0}>
            <img src={urlImagen(im.archivo, 'miniatura')} alt="" aria-hidden="true" loading="lazy" />
            <span class="tira__etiqueta">{im.aumento || `Imagen ${i + 1}`}</span>
            <span class="solo-lectores">
              Ver {im.aumento ? `el aumento ${im.aumento}` : `la imagen ${i + 1}`} de {titulo}
            </span>
          </button>
        ))}
      </div>
    )
  }

  {/* Minimapa: solo en escritorio. Debajo de 1024 el riel de zoom ocupa esa
      esquina y, sobre todo, sobre la lamina en movil no va nada mas que los
      marcadores y el riel. */}
  <div
    id="minimapa"
    class="chapa-campo absolute top-3 right-3 z-20 h-24 w-32 overflow-hidden max-lg:hidden! lg:right-[23.75rem]"
    aria-hidden="true"
  >
  </div>

  {/* El riel de zoom: la alternativa obligatoria al pellizco. En movil se va
      arriba a la derecha, lejos del pulgar que arrastra y de la ficha que
      sube por abajo. */}
  <div class="riel" role="group" aria-label="Tamaño de la lámina">
    <button type="button" class="boton-visor" data-accion="acercar" aria-keyshortcuts="+">
      <span class="solo-lectores">Acercar</span>
      <Icono nombre="magnifying-glass-plus" />
    </button>
    <button type="button" class="boton-visor" data-accion="alejar" aria-keyshortcuts="-">
      <span class="solo-lectores">Alejar</span>
      <Icono nombre="magnifying-glass-minus" />
    </button>
    <button type="button" class="boton-visor" data-accion="ajustar" aria-keyshortcuts="0">
      <span class="solo-lectores">Ajustar a la pantalla</span>
      <Icono nombre="corners-in" />
    </button>
    {/* A pantalla completa solo en escritorio: en el movil el navegador ya
        se queda con la pantalla y el boton seria un cuarto objetivo de 44 px
        sobre una foto de 280. */}
    <button type="button" class="boton-visor max-lg:hidden" data-accion="pantalla-completa">
      <span class="solo-lectores">Pantalla completa</span>
      <Icono nombre="corners-out" />
    </button>
  </div>

  {/* El aumento, arriba a la izquierda y solo mientras cambia: informa sin
      quedarse ocupando sitio sobre la lamina. */}
  <p id="chip-zoom" class="chip-zoom tabular-nums" aria-hidden="true" data-visible="no"></p>

  <!-- Crédito de la imagen visible -->
  <p
    id="credito-imagen"
    class="pointer-events-none absolute right-4 bottom-3.5 z-10 max-w-[min(26rem,40%)] truncate text-right text-[0.68rem] text-white/55 max-lg:hidden lg:right-[24.5rem]"
  >
  </p>
</div>

<style is:global>
  /* ---------- Carga y error ---------- */
  .cargando {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .cargando[hidden] {
    display: none;
  }
  .cargando__previa {
    width: 100%;
    height: 100%;
    object-fit: contain;
    filter: blur(14px);
    opacity: 0.55;
    transform: scale(1.04);
  }
  /* Una barra de 3 px bajo la cabecera del visor, no un disco que gira. */
  .cargando__barra {
    position: absolute;
    top: 0;
    left: 0;
    height: 3px;
    width: 40%;
    background: var(--color-eosina);
    animation: atlas-cargando 1.3s ease-in-out infinite;
  }
  @keyframes atlas-cargando {
    0% {
      left: -40%;
    }
    100% {
      left: 100%;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .cargando__barra {
      animation: none;
      width: 100%;
      opacity: 0.5;
    }
  }

  .fallo {
    position: absolute;
    inset: 0;
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 0.9rem;
    padding: 1.5rem;
    text-align: center;
  }
  .fallo[hidden] {
    display: none;
  }
  .fallo__texto {
    font-family: var(--font-serif);
    font-size: 1.15rem;
    color: rgb(255 255 255 / 0.9);
  }
  .fallo__boton {
    min-height: 44px;
    border: 1px solid rgb(255 255 255 / 0.4);
    border-radius: var(--radius-chapa);
    padding: 0.5rem 1.1rem;
    font-size: 0.9rem;
    color: #fff;
    transition: background-color 140ms;
  }
  .fallo__boton:hover {
    background: rgb(255 255 255 / 0.14);
  }

  /* ---------- La tira de imágenes ----------
     Una placa puede traer dos o tres fotos del mismo corte a distinto aumento.
     Antes se elegían con botones de texto y no se sabía qué había detrás de
     cada uno: ahora se ve la foto, como las hojas de un portaobjetos. */
  .tira {
    position: absolute;
    top: 0.75rem;
    left: 0.75rem;
    z-index: 20;
    display: flex;
    gap: 0.4rem;
  }
  .tira__cabecera {
    display: none;
  }

  /* En movil la tira sale de encima de la lamina y se convierte en una hoja
     que abre el boton de imagenes de la cabecera: 46 miniaturas no caben en
     una foto de 280 px de alto y encima competian con el arrastre. */
  @media (max-width: 1023px) {
    .tira {
      position: fixed;
      inset-inline: 0;
      bottom: 0;
      top: auto;
      z-index: 60;
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(5.5rem, 1fr));
      gap: 0.6rem;
      max-height: 70dvh;
      overflow-y: auto;
      overscroll-behavior: contain;
      border-radius: var(--radius-hoja) var(--radius-hoja) 0 0;
      background: var(--atlas-superficie);
      box-shadow: var(--atlas-sombra-hoja);
      padding: 0.9rem 1rem calc(1.1rem + env(safe-area-inset-bottom));
      transition: transform 240ms var(--ease-visor);
    }
    .tira[data-abierta='no'] {
      transform: translateY(105%);
      visibility: hidden;
      pointer-events: none;
    }
    .tira__cabecera {
      display: flex;
      grid-column: 1 / -1;
      align-items: center;
      justify-content: space-between;
      gap: 0.5rem;
    }
    .tira__titulo {
      font-family: var(--font-serif);
      font-size: 1.02rem;
    }
    .tira__cerrar {
      display: grid;
      place-items: center;
      width: var(--medida-tactil);
      height: var(--medida-tactil);
      margin-right: -0.6rem;
      flex: none;
      border-radius: var(--radius-chapa);
      font-size: 1.1rem;
      color: var(--atlas-texto-suave);
    }
    @media (prefers-reduced-motion: reduce) {
      .tira {
        transition: none;
      }
    }
  }

  @media (min-width: 1024px) {
    .tira {
      flex-direction: column;
    }
    .tira__hoja {
      width: 4.25rem;
    }
    .tira__hoja img {
      height: 2.75rem;
    }
  }

  .tira__hoja {
    position: relative;
    display: block;
    /* En movil el visor mide poco: la tira se encoge para no comerse la
       lamina, y en escritorio se ve del tamano que merece. */
    width: 3.25rem;
    overflow: hidden;
    border-radius: var(--radius-chapa);
    border: 1px solid rgb(255 255 255 / 0.22);
    background: rgb(14 9 32 / 0.72);
    box-shadow: 0 6px 18px -10px rgb(0 0 0 / 0.8);
    transition:
      border-color 150ms,
      transform 150ms;
  }
  .tira__hoja img {
    display: block;
    width: 100%;
    height: 2.1rem;
    object-fit: cover;
    opacity: 0.72;
    transition: opacity 150ms;
  }
  .tira__hoja:hover {
    border-color: rgb(255 255 255 / 0.55);
  }
  .tira__hoja:hover img {
    opacity: 1;
  }
  .tira__hoja[aria-pressed='true'] {
    border-color: var(--color-eosina);
  }
  .tira__hoja[aria-pressed='true'] img {
    opacity: 1;
  }

  .tira__etiqueta {
    display: block;
    padding: 0.1rem 0.25rem 0.15rem;
    font-size: 0.62rem;
    line-height: 1.3;
    font-variant-numeric: tabular-nums;
    text-align: center;
    color: rgb(255 255 255 / 0.78);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .tira__hoja[aria-pressed='true'] .tira__etiqueta {
    background: var(--color-eosina);
    color: var(--atlas-sobre-eosina);
  }

  /* Dentro de la hoja, en movil, las miniaturas ya no flotan sobre el campo
     oscuro del visor: estan sobre papel y se visten como el resto del sitio,
     con sitio de sobra para verlas de verdad. */
  @media (max-width: 1023px) {
    .tira__hoja {
      width: auto;
      border-color: var(--atlas-borde);
      background: var(--atlas-fondo);
      box-shadow: none;
    }
    .tira__hoja img {
      height: 4.5rem;
      opacity: 1;
    }
    .tira__etiqueta {
      padding-block: 0.3rem;
      font-size: 0.7rem;
      color: var(--atlas-texto-suave);
    }
    .tira__hoja[aria-pressed='true'] {
      border-color: var(--atlas-texto);
    }
  }

  /* ---------- Marcadores numerados ----------
     Anillo de tinta con el numero dentro y un halo de papel de 2 px: asi se
     lee igual sobre tejido claro que sobre tejido oscuro. El activo NO va en
     eosina: sobre una tincion rosa la eosina desaparece, asi que se invierte
     en tinta, que es lo unico que contrasta con todo lo que hay debajo. */
  /* ---------- La marca de una estructura · propuesta G ----------
     Un bocadillo de comic: el punto es un aro de tinta en el sitio exacto y
     al lado, apuntando con su pico, una cajita con el nombre. Mismo filo de
     2 px y misma sombra maciza que el resto de la interfaz. */
  .indicador {
    position: absolute;
    width: 0;
    height: 0;
  }

  .marcador {
    position: absolute;
    top: 0;
    left: 0;
    display: flex;
    align-items: center;
    padding-block: 12px;
    transform: translateY(-50%);
    cursor: pointer;
    text-align: left;
  }
  .indicador[data-lado='izquierda'] .marcador {
    left: auto;
    right: 0;
    flex-direction: row-reverse;
    text-align: right;
  }

  /* El aro: blanco con filo de tinta, visible sobre cualquier tincion. */
  .indicador__punto {
    position: absolute;
    left: 0;
    top: 50%;
    width: 11px;
    height: 11px;
    border-radius: 999px;
    border: 2.5px solid #2e2733;
    background: #fff;
    transform: translate(-50%, -50%);
    transition: width 200ms var(--brinco), height 200ms var(--brinco), background-color 200ms;
  }
  .indicador[data-lado='izquierda'] .indicador__punto {
    left: auto;
    right: 0;
    transform: translate(50%, -50%);
  }

  .indicador__guia {
    width: 1rem;
    height: 2.5px;
    flex: none;
    background: #2e2733;
  }

  /* El bocadillo. */
  .indicador__rotulo {
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.4rem;
    max-width: 11.5rem;
    padding: 0.16rem 0.6rem 0.2rem 0.3rem;
    border: 2.5px solid #2e2733;
    border-radius: 0.7rem;
    background: #fff;
    box-shadow: 3px 3px 0 #2e2733;
    color: #2e2733;
    transition: transform 180ms var(--brinco), background-color 180ms, box-shadow 180ms;
  }
  .indicador[data-lado='izquierda'] .indicador__rotulo {
    flex-direction: row-reverse;
    padding: 0.16rem 0.3rem 0.2rem 0.6rem;
  }
  /* El pico, un cuadrado girado que tapa el filo del bocadillo. */
  .indicador__rotulo::before {
    content: '';
    position: absolute;
    left: -7px;
    top: 50%;
    width: 10px;
    height: 10px;
    background: inherit;
    border-left: 2.5px solid #2e2733;
    border-bottom: 2.5px solid #2e2733;
    transform: translateY(-50%) rotate(45deg);
  }
  .indicador[data-lado='izquierda'] .indicador__rotulo::before {
    left: auto;
    right: -7px;
    border-left: 0;
    border-bottom: 0;
    border-right: 2.5px solid #2e2733;
    border-top: 2.5px solid #2e2733;
  }

  .indicador__numero {
    display: grid;
    place-items: center;
    height: 1.2rem;
    min-width: 1.2rem;
    flex: none;
    border-radius: 0.4rem;
    border: 2px solid #2e2733;
    background: #ffd9e7;
    font-family: var(--font-sans);
    font-size: 0.62rem;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    line-height: 1;
    color: #2e2733;
  }

  .indicador__texto {
    font-family: var(--font-sans);
    font-size: 0.8rem;
    font-weight: 700;
    line-height: 1.25;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  /* Activa: el aro se rellena y el bocadillo se pinta de rosa. */
  .indicador--activa {
    z-index: 3;
  }
  .indicador--activa .indicador__punto {
    width: 15px;
    height: 15px;
    background: var(--marca-rosa);
  }
  .indicador--activa .indicador__rotulo {
    background: var(--marca-rosa);
    color: #fff;
    transform: translate(-2px, -2px);
    box-shadow: 5px 5px 0 #2e2733;
  }
  .indicador--activa .indicador__numero {
    background: #fff;
    color: var(--marca-rosa);
  }

  .marcador:hover .indicador__rotulo {
    transform: translate(-2px, -2px);
    box-shadow: 5px 5px 0 #2e2733;
  }
  .marcador:active .indicador__rotulo {
    transform: translate(1px, 1px);
    box-shadow: 1px 1px 0 #2e2733;
  }

  .marcador:focus-visible {
    outline: none;
  }
  .marcador:focus-visible .indicador__rotulo {
    box-shadow: 3px 3px 0 #2e2733, 0 0 0 3px var(--marca-rosa);
  }

  /* Modo repaso. */
  .indicador--oculta .indicador__texto {
    font-size: 0;
  }
  .indicador--oculta .indicador__texto::after {
    content: 'por revelar';
    font-size: 0.8rem;
    font-weight: 600;
    opacity: 0.7;
  }

  @media (max-width: 639px) {
    .indicador__guia {
      width: 0.7rem;
    }
    .indicador__rotulo {
      max-width: 8rem;
    }
    .indicador__texto {
      font-size: 0.74rem;
    }
  }

  /* ---------- El riel de zoom ----------
     Sobre la lamina solo hay dos materiales: tinta y papel. El riel es papel
     translucido con los iconos en tinta, el mismo par que los marcadores, y
     no la chapa oscura de antes: sobre una tincion clara una chapa negra
     pesa mas que la propia foto. */
  .riel {
    position: absolute;
    z-index: 20;
    display: flex;
    align-items: center;
    gap: 0.1rem;
    padding: 0.15rem;
    border-radius: var(--radius-chapa);
    border: 1px solid var(--atlas-borde-fuerte);
    background: var(--atlas-velo);
    backdrop-filter: blur(8px);
    box-shadow: var(--atlas-sombra-riel);
    /* Escritorio: abajo a la izquierda, donde no tapa nada. */
    bottom: 0.75rem;
    left: 0.75rem;
  }
  /* Movil: arriba a la derecha, lejos del pulgar y de la hoja de la ficha. */
  @media (max-width: 1023px) {
    .riel {
      top: 8px;
      right: 8px;
      bottom: auto;
      left: auto;
      flex-direction: column;
      gap: 0;
    }
  }

  .boton-visor {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border-radius: var(--radius-chapa);
    font-size: 1.15rem;
    color: var(--atlas-texto);
    transition:
      background-color 140ms,
      color 140ms;
  }
  .boton-visor:hover {
    background: color-mix(in srgb, var(--atlas-texto) 10%, transparent);
  }
  /* En movil el dedo manda: los tres del riel miden 44 px de verdad. */
  @media (max-width: 1023px) {
    .boton-visor {
      width: var(--medida-tactil);
      height: var(--medida-tactil);
    }
    /* Tres botones y no cuatro: la utilidad de Tailwind va en una capa y
       pierde contra la regla de arriba, asi que se dice aqui. */
    .boton-visor[data-accion='pantalla-completa'] {
      display: none;
    }
  }

  /* ---------- El aumento, mientras cambia ---------- */
  .chip-zoom {
    position: absolute;
    top: 8px;
    left: 8px;
    z-index: 20;
    border-radius: var(--radius-chapa);
    background: var(--atlas-velo);
    backdrop-filter: blur(8px);
    padding: 0.15rem 0.4rem;
    font-size: 0.72rem;
    color: var(--atlas-texto);
    transition: opacity 200ms;
  }
  .chip-zoom[data-visible='no'] {
    opacity: 0;
    visibility: hidden;
  }
  @media (min-width: 1024px) {
    /* En escritorio el minimapa ya dice donde estas: el chip sobra. */
    .chip-zoom {
      display: none;
    }
  }

  /* El minimapa de OpenSeadragon */
  #minimapa .displayregion {
    border: 2px solid var(--color-eosina) !important;
  }
</style>
