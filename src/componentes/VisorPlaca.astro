---
import type { ImagenPlaca } from '../utils/placas';
import { urlImagen } from '../utils/placas';
import Icono from './Icono.astro';

interface Props {
  imagenes: ImagenPlaca[];
  titulo: string;
}
const { imagenes, titulo } = Astro.props;
const variasImagenes = imagenes.length > 1;
---

<div id="marco-visor" class="vineta-campo relative isolate h-full w-full overflow-hidden bg-campo">
  <!-- Contenedor de OpenSeadragon -->
  <div
    id="visor"
    class="absolute inset-0"
    aria-label={`Visor de la preparación: ${titulo}`}
    role="application"
  >
  </div>

  {/* Mientras llega la lámina grande se enseña la miniatura desenfocada: se
      ve de qué va la preparación en vez de un rectángulo vacío. */}
  <div id="estado-visor" class="cargando" role="status">
    <img
      class="cargando__previa"
      src={urlImagen(imagenes[0]!.archivo, 'miniatura')}
      alt=""
      aria-hidden="true"
    />
    <span class="cargando__barra" aria-hidden="true"></span>
    <span class="solo-lectores">Cargando la preparación: {titulo}</span>
  </div>

  {/* Si la imagen no llega, la lámina sigue sirviendo: debajo queda su lista
      de estructuras y su ficha. */}
  <div id="fallo-visor" class="fallo" role="alert" hidden>
    <p class="fallo__texto">No se pudo cargar la imagen de esta preparación.</p>
    <button type="button" id="fallo-reintentar" class="fallo__boton">Reintentar</button>
  </div>

  {
    variasImagenes && (
      <div class="tira" role="group" aria-label="Imágenes de esta preparación">
        {imagenes.map((im, i) => (
          <button type="button" class="tira__hoja" data-imagen={i} aria-pressed={i === 0}>
            <img src={urlImagen(im.archivo, 'miniatura')} alt="" aria-hidden="true" loading="lazy" />
            <span class="tira__etiqueta">{im.aumento || `Imagen ${i + 1}`}</span>
            <span class="solo-lectores">
              Ver {im.aumento ? `el aumento ${im.aumento}` : `la imagen ${i + 1}`} de {titulo}
            </span>
          </button>
        ))}
      </div>
    )
  }

  <!-- Minimapa -->
  <div
    id="minimapa"
    class="chapa-campo absolute top-3 right-3 z-20 h-24 w-32 overflow-hidden max-sm:hidden! lg:right-[23.75rem]"
    aria-hidden="true"
  >
  </div>

  <!-- Controles de tamaño -->
  <div class="chapa-campo absolute bottom-3 left-3 z-20 flex items-center gap-0.5 p-1">
    <button type="button" class="boton-visor" data-accion="acercar" aria-keyshortcuts="+">
      <span class="solo-lectores">Acercar</span>
      <Icono nombre="magnifying-glass-plus" />
    </button>
    <button type="button" class="boton-visor" data-accion="alejar" aria-keyshortcuts="-">
      <span class="solo-lectores">Alejar</span>
      <Icono nombre="magnifying-glass-minus" />
    </button>
    <button type="button" class="boton-visor" data-accion="ajustar" aria-keyshortcuts="0">
      <span class="solo-lectores">Ajustar a la pantalla</span>
      <Icono nombre="corners-in" />
    </button>
    <button type="button" class="boton-visor" data-accion="pantalla-completa">
      <span class="solo-lectores">Pantalla completa</span>
      <Icono nombre="corners-out" />
    </button>
  </div>

  <!-- Crédito de la imagen visible -->
  <p
    id="credito-imagen"
    class="pointer-events-none absolute right-4 bottom-3.5 z-10 max-w-[min(26rem,40%)] truncate text-right text-[0.68rem] text-white/55 max-lg:hidden lg:right-[24.5rem]"
  >
  </p>
</div>

<style is:global>
  /* ---------- Carga y error ---------- */
  .cargando {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .cargando[hidden] {
    display: none;
  }
  .cargando__previa {
    width: 100%;
    height: 100%;
    object-fit: contain;
    filter: blur(14px);
    opacity: 0.55;
    transform: scale(1.04);
  }
  /* Una barra de 3 px bajo la cabecera del visor, no un disco que gira. */
  .cargando__barra {
    position: absolute;
    top: 0;
    left: 0;
    height: 3px;
    width: 40%;
    background: var(--color-eosina);
    animation: atlas-cargando 1.3s ease-in-out infinite;
  }
  @keyframes atlas-cargando {
    0% {
      left: -40%;
    }
    100% {
      left: 100%;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .cargando__barra {
      animation: none;
      width: 100%;
      opacity: 0.5;
    }
  }

  .fallo {
    position: absolute;
    inset: 0;
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 0.9rem;
    padding: 1.5rem;
    text-align: center;
  }
  .fallo[hidden] {
    display: none;
  }
  .fallo__texto {
    font-family: var(--font-serif);
    font-size: 1.15rem;
    color: rgb(255 255 255 / 0.9);
  }
  .fallo__boton {
    min-height: 44px;
    border: 1px solid rgb(255 255 255 / 0.4);
    border-radius: var(--radius-chapa);
    padding: 0.5rem 1.1rem;
    font-size: 0.9rem;
    color: #fff;
    transition: background-color 140ms;
  }
  .fallo__boton:hover {
    background: rgb(255 255 255 / 0.14);
  }

  /* ---------- La tira de imágenes ----------
     Una placa puede traer dos o tres fotos del mismo corte a distinto aumento.
     Antes se elegían con botones de texto y no se sabía qué había detrás de
     cada uno: ahora se ve la foto, como las hojas de un portaobjetos. */
  .tira {
    position: absolute;
    top: 0.75rem;
    left: 0.75rem;
    z-index: 20;
    display: flex;
    gap: 0.4rem;
  }
  @media (min-width: 1024px) {
    .tira {
      flex-direction: column;
    }
    .tira__hoja {
      width: 4.25rem;
    }
    .tira__hoja img {
      height: 2.75rem;
    }
  }

  .tira__hoja {
    position: relative;
    display: block;
    /* En movil el visor mide poco: la tira se encoge para no comerse la
       lamina, y en escritorio se ve del tamano que merece. */
    width: 3.25rem;
    overflow: hidden;
    border-radius: var(--radius-chapa);
    border: 1px solid rgb(255 255 255 / 0.22);
    background: rgb(14 9 32 / 0.72);
    box-shadow: 0 6px 18px -10px rgb(0 0 0 / 0.8);
    transition:
      border-color 150ms,
      transform 150ms;
  }
  .tira__hoja img {
    display: block;
    width: 100%;
    height: 2.1rem;
    object-fit: cover;
    opacity: 0.72;
    transition: opacity 150ms;
  }
  .tira__hoja:hover {
    border-color: rgb(255 255 255 / 0.55);
  }
  .tira__hoja:hover img {
    opacity: 1;
  }
  .tira__hoja[aria-pressed='true'] {
    border-color: var(--color-eosina);
  }
  .tira__hoja[aria-pressed='true'] img {
    opacity: 1;
  }

  .tira__etiqueta {
    display: block;
    padding: 0.1rem 0.25rem 0.15rem;
    font-size: 0.62rem;
    line-height: 1.3;
    font-variant-numeric: tabular-nums;
    text-align: center;
    color: rgb(255 255 255 / 0.78);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .tira__hoja[aria-pressed='true'] .tira__etiqueta {
    background: var(--color-eosina);
    color: var(--atlas-sobre-eosina);
  }

  /* ---------- Marcadores numerados ----------
     Anillo de tinta con el numero dentro y un halo de papel de 2 px: asi se
     lee igual sobre tejido claro que sobre tejido oscuro. El activo NO va en
     eosina: sobre una tincion rosa la eosina desaparece, asi que se invierte
     en tinta, que es lo unico que contrasta con todo lo que hay debajo. */
  .marcador {
    position: relative;
    display: grid;
    place-items: center;
    width: 1.5rem;
    height: 1.5rem;
    border-radius: 999px;
    border: 2px solid var(--atlas-texto);
    background: var(--atlas-fondo);
    color: var(--atlas-texto);
    box-shadow: 0 0 0 2px var(--atlas-fondo);
    cursor: pointer;
    transition:
      width 160ms var(--ease-visor),
      height 160ms var(--ease-visor),
      background-color 160ms,
      color 160ms;
  }

  /* El objetivo tactil llega a 44 px aunque el anillo mida 24: en movil el
     dedo no acierta un circulo de 24 px sobre una foto que ademas se arrastra. */
  .marcador::before {
    content: '';
    position: absolute;
    inset: calc((1.5rem - 44px) / 2);
    border-radius: 999px;
  }

  .marcador > span {
    font-family: var(--font-sans);
    font-size: 0.75rem;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    line-height: 1;
  }

  .marcador:hover {
    background: var(--atlas-superficie-alta);
  }

  /* Activo: el anillo se invierte y crece a 28 px. */
  .marcador--activo {
    width: 1.75rem;
    height: 1.75rem;
    background: var(--atlas-texto);
    color: var(--atlas-fondo);
  }
  .marcador--activo:hover {
    background: var(--atlas-texto);
  }

  /* El pulso va en una capa aparte para no pisar el filo del anillo. */
  .marcador--activo::after {
    content: '';
    position: absolute;
    inset: -2px;
    border-radius: 999px;
    animation: atlas-pulso-marcador 1.6s ease-out infinite;
  }

  /* El foco de la interfaz es eosina, pero sobre la tincion no se ve: aqui
     es un anillo doble de tinta y papel. */
  .marcador:focus-visible {
    outline: none;
    box-shadow:
      0 0 0 2px var(--atlas-fondo),
      0 0 0 4px var(--atlas-texto);
  }

  @media (prefers-reduced-motion: reduce) {
    .marcador--activo::after {
      animation: none;
    }
  }

  /* En modo repaso el numero se sustituye por una interrogacion hasta que la
     estructura se revela; el marcador sigue estando donde estaba. */
  .marcador--oculto > span {
    font-size: 0;
  }
  .marcador--oculto > span::after {
    content: '?';
    font-size: 0.75rem;
  }

  /* ---------- Botones sobre el campo oscuro ---------- */
  .boton-visor {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border-radius: var(--radius-chapa);
    font-size: 1.15rem;
    color: rgb(255 255 255 / 0.8);
    transition:
      background-color 140ms,
      color 140ms;
  }
  .boton-visor:hover {
    background: rgb(255 255 255 / 0.14);
    color: #fff;
  }

  /* El minimapa de OpenSeadragon */
  #minimapa .displayregion {
    border: 2px solid var(--color-eosina) !important;
  }
</style>
