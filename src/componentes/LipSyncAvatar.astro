---
/**
 * Las bocas de una caricatura con lip-sync, apiladas sobre su cara base.
 *
 * Solo pinta las capas: la cara de abajo la pone Avatar.astro, y quien decide
 * que boca se ve en cada momento es el controlador del cliente
 * (src/cliente/lipsync-avatar.ts), que sigue el audio con su JSON de
 * public/lipsync/. Cada boca es un recorte pequeno con el borde difuminado
 * (npm run visemas), asi que lo unico que cambia al hablar es la boca: el
 * pelo, los ojos y la bata son siempre la misma imagen.
 */
import type { GrupoVisemas, Visemas } from '../utils/avatares';
import { ruta } from '../utils/ruta';

interface Props {
  carpeta: string;
  visemas: Visemas;
}
const { carpeta, visemas } = Astro.props;
const pct = (n: number) => `${(n * 100).toFixed(3)}%`;
const lugar = (g: GrupoVisemas) =>
  `left:${pct(g.x)};top:${pct(g.y)};width:${pct(g.ancho)};height:${pct(g.alto)}`;
---

{visemas.boca.piezas.map((boca) => (
  <img
    src={ruta('avatares', carpeta, 'visemas', `${boca}.webp`)}
    alt=""
    aria-hidden="true"
    decoding="async"
    class="lipsync__boca"
    style={lugar(visemas.boca)}
    data-visema={boca}
  />
))}
{/* Los ojos cerrados: se destapan un instante de vez en cuando (parpadeo). */}
{visemas.ojos && (
  <img
    src={ruta('avatares', carpeta, 'visemas', 'ojos.webp')}
    alt=""
    aria-hidden="true"
    decoding="async"
    class="lipsync__ojos"
    style={lugar(visemas.ojos)}
    data-parpado
  />
)}

<style>
  /* Cada boca espera tapada encima de la cara. La que entra aparece por
     encima de la que sale y esta se apaga un instante despues, ya cubierta:
     asi nunca se ve la cara base a medio camino entre dos bocas. */
  .lipsync__boca {
    position: absolute;
    max-width: none;
    opacity: 0;
    pointer-events: none;
    transition: opacity 60ms linear;
  }
  /* El parpadeo baja rapido y sube un poco mas lento, como uno de verdad. */
  .lipsync__ojos {
    position: absolute;
    z-index: 3;
    max-width: none;
    opacity: 0;
    pointer-events: none;
    transition: opacity 70ms ease-in;
  }
  .lipsync__ojos[data-activo] {
    opacity: 1;
    transition-duration: 40ms;
  }
  @media (prefers-reduced-motion: reduce) {
    .lipsync__ojos,
    .lipsync__boca {
      display: none;
    }
  }
</style>
